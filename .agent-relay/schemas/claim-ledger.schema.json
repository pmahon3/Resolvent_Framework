{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "original_conjecture", "claims", "open_gate", "formalization_boundary", "next_task", "controlling_files", "scope_qualifications", "accepted_commit"],
  "properties": {
    "schema_version": {"const": 1},
    "original_conjecture": {"type": "string"},
    "claims": {"type": "object", "additionalProperties": {"$ref": "#/$defs/claim"}},
    "open_gate": {"type": "string"},
    "formalization_boundary": {"type": "string"},
    "next_task": {"type": "string"},
    "controlling_files": {"type": "array", "items": {"type": "string"}},
    "scope_qualifications": {"type": "string"},
    "accepted_commit": {"type": "string"}
  },
  "$defs": {
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": ["statement", "category", "status", "scope", "evidence_class", "evidence", "supersedes", "introduced_by", "last_reviewed_by"],
      "properties": {
        "statement": {"type": "string"},
        "category": {"enum": ["banked_result", "closed_architecture"]},
        "status": {"enum": ["accepted", "superseded", "withdrawn"]},
        "scope": {"type": "string"},
        "evidence_class": {"enum": ["hand_proof", "executable_or_finite", "lean", "research_state"]},
        "evidence": {"type": "array", "items": {"type": "string"}},
        "supersedes": {"type": ["string", "null"]},
        "introduced_by": {"type": "string"},
        "last_reviewed_by": {"type": ["string", "null"]}
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "project", "branch", "accepted_commit", "iteration", "status", "current_handoff_path", "last_run_id", "last_outcome", "consecutive_rejections", "review_backend", "candidate", "updated_at"],
  "properties": {
    "schema_version": {"const": 2},
    "project": {"const": "Resolvent_Framework"},
    "branch": {"type": "string"},
    "accepted_commit": {"type": "string"},
    "iteration": {"type": "integer", "minimum": 0},
    "status": {"enum": ["uninitialized", "initialized"]},
    "current_handoff_path": {"type": "string"},
    "last_run_id": {"type": ["string", "null"]},
    "last_outcome": {"type": ["string", "null"]},
    "consecutive_rejections": {"type": "integer", "minimum": 0},
    "review_backend": {"enum": ["codex", "openai"]},
    "candidate": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "branch", "worktree", "initial_base", "current_tip", "status", "latest_run_id"],
          "properties": {
            "name": {"type": "string"},
            "branch": {"type": "string"},
            "worktree": {"type": "string"},
            "initial_base": {"type": "string"},
            "current_tip": {"type": "string"},
            "status": {"enum": ["ready", "executing", "executed", "validated", "awaiting_human", "needs_correction"]},
            "latest_run_id": {"type": ["string", "null"]}
          }
        }
      ]
    },
    "updated_at": {"type": "string"}
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "project", "branch", "accepted_commit", "iteration", "status", "current_handoff_path", "last_run_id", "last_outcome", "consecutive_rejections", "review_backend", "updated_at"],
  "properties": {
    "schema_version": {"const": 2},
    "project": {"const": "Resolvent_Framework"},
    "branch": {"type": "string"},
    "accepted_commit": {"type": "string", "description": "Accepted mathematical executor commit; branch HEAD may be a later control-plane commit."},
    "iteration": {"type": "integer", "minimum": 0},
    "status": {"enum": ["uninitialized", "initialized", "prepared", "executed", "executor_uncommitted", "validated", "awaiting_human", "finalized"]},
    "current_handoff_path": {"type": "string"},
    "last_run_id": {"type": ["string", "null"]},
    "last_outcome": {"type": ["string", "null"]},
    "consecutive_rejections": {"type": "integer", "minimum": 0},
    "review_backend": {"enum": ["codex", "openai"]},
    "updated_at": {"type": "string"}
  }
}

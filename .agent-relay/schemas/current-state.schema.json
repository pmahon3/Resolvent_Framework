{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "project", "branch", "accepted_commit", "iteration", "status", "current_handoff_path", "last_run_id", "last_outcome", "consecutive_rejections", "review_backend", "candidate", "updated_at"],
  "properties": {
    "schema_version": {"const": 2},
    "project": {"const": "Resolvent_Framework"},
    "branch": {"type": "string"},
    "accepted_commit": {"type": "string"},
    "iteration": {"type": "integer", "minimum": 0},
    "status": {"enum": ["uninitialized", "initialized"]},
    "current_handoff_path": {"type": "string"},
    "last_run_id": {"type": ["string", "null"]},
    "last_outcome": {"type": ["string", "null"]},
    "consecutive_rejections": {"type": "integer", "minimum": 0},
    "review_backend": {"enum": ["codex", "openai"]},
    "candidate": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "branch", "worktree", "initial_base", "current_tip", "status", "latest_run_id"],
          "properties": {
            "name": {"type": "string"},
            "branch": {"type": "string"},
            "worktree": {"type": "string"},
            "initial_base": {"type": "string"},
            "current_tip": {"type": "string"},
            "status": {"enum": ["ready", "executing", "execution_error", "executed", "validation_passed", "validation_failed", "validation_error", "reviewing", "review_error", "awaiting_human", "needs_correction", "recovery_required", "integrating_prepared", "control_committed"]},
            "latest_run_id": {"type": ["string", "null"]},
            "phase": {
              "type": "object",
              "additionalProperties": false,
              "required": ["name", "pid", "hostname", "started_at", "candidate_head", "packet_sha256"],
              "properties": {
                "name": {"type": "string"},
                "pid": {"type": "integer"},
                "hostname": {"type": "string"},
                "started_at": {"type": "string"},
                "candidate_head": {"type": "string"},
                "packet_sha256": {"type": ["string", "null"]}
              }
            }
          }
        }
      ]
    },
    "updated_at": {"type": "string"}
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["run_id", "iteration", "started_at", "completed_at", "accepted_parent_commit", "executor_commit", "final_accepted_commit", "handoff_sha256", "state_sha256_before", "state_sha256_after", "executor_outcome", "review_verdict", "validation_status", "changed_files", "claims_accepted", "claims_rejected", "next_task", "executor_usage", "reviewer_usage", "human_decision"],
  "properties": {
    "schema_version": {"const": 2},
    "run_id": {"type": "string"},
    "iteration": {"type": "integer", "minimum": 1},
    "started_at": {"type": "string"},
    "completed_at": {"type": "string"},
    "base_commit": {"type": "string", "description": "Control-plane branch HEAD from which the executor worktree was created."},
    "accepted_parent_commit": {"type": "string", "description": "Legacy-compatible alias of base_commit."},
    "executor_commit": {"type": "string", "description": "Mathematical executor commit."},
    "final_accepted_commit": {"type": ["string", "null"], "description": "Accepted mathematical executor commit, or null on rejection; never the containing control commit."},
    "handoff_sha256": {"type": "string"},
    "state_sha256_before": {"type": "string"},
    "state_sha256_after": {"type": ["string", "null"]},
    "executor_outcome": {"type": "string"},
    "review_verdict": {"type": "string"},
    "validation_status": {"type": "string"},
    "changed_files": {"type": "array", "items": {"type": "string"}},
    "claims_accepted": {"type": "array", "items": {"type": "string"}},
    "claims_rejected": {"type": "array", "items": {"type": "string"}},
    "next_task": {"type": "string"},
    "executor_usage": {"type": "object"},
    "reviewer_usage": {"type": "object"},
    "human_decision": {"enum": ["accept", "reject"]},
    "review_override": {
      "type": ["object", "null"],
      "properties": {"reason": {"type": "string"}, "recorded_at": {"type": "string"}},
      "required": ["reason", "recorded_at"],
      "additionalProperties": false
    }
  }
}

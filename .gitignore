# Submission packages (venue-specific, not source)
papers/**/submission_*/

# Literature library — third-party paper PDFs + page scans (downloaded copies,
# not our work; ~94 MB of binaries, not redistributable). Kept on disk locally,
# not tracked. The library is reconstructable from the bibliography; the
# literature_review .bib/.tex (and the compiled review PDF) stay tracked.
notes/literature_review/literature/**/*.pdf
notes/literature_review/literature/**/*.jpg
notes/literature_review/literature/**/*.jpeg
notes/literature_review/literature/**/*.png

# LaTeX build artifacts
*.aux
*.bbl
*.blg
*.log
*.out
*.synctex.gz
*.toc
*.bcf
*.fdb_latexmk
*.fls
*.run.xml

# macOS
.DS_Store

# Lean / Lake build artifacts
.lake/build/

# Python
.venv/
__pycache__/
*.pyc
*.pyo

# Node
node_modules/
dist/

# Claude Code settings (local, not for sharing)
.claude/

# JetBrains IDE
.idea/

# Jupyter notebook checkpoints
.ipynb_checkpoints/
**/.ipynb_checkpoints/

# generated by formalization/tools/prover/sorries.py
formalization/tools/prover/open_goals.json

# blueprint build artefacts (blueprint/lean_decls IS tracked -- CI checks it)
formalization/QuerySystem/blueprint/web/
formalization/QuerySystem/blueprint/print/
formalization/QuerySystem/blueprint/checkdecls.lean
formalization/QuerySystem/blueprint/checkdecls.log
formalization/QuerySystem/blueprint/src/*.paux

# grind reports (regenerated)
*.grind.json

# retrodiction copies are generated by tools/prover/blank.py
formalization/staging/*_retro.lean

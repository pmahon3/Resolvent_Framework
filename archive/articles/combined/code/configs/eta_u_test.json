{
  "experiment": "eta_u_test_quick",
  "description": "Quick test of η(u) transition curve implementation",

  "system": {
    "q": 1.5,
    "sigma": 0.01,
    "n": 15000,
    "seed": 46
  },

  "queries": {
    "percentile_range": [50, 95],
    "n_queries": 100,
    "bins": {
      "method": "quantiles_10"
    }
  },

  "bandwidth": {
    "method": "geometric_grid",
    "h_star_multipliers": [
      1.0, 1.2, 1.4, 1.6, 1.8, 2.0, 2.5, 3.0, 3.5,
      4.0, 4.5, 5.0, 6.0, 7.0, 8.0, 9.0, 10.0,
      12.0, 14.0, 16.0, 18.0, 20.0
    ],
    "fit_start_multiplier": 1.6,
    "min_span_decades": 0.8,
    "use_robust_slope": true,
    "curvature_guard_threshold": 100.0
  },

  "kernels": {
    "primary": "tricube",
    "control": "gaussian",
    "locality_guards": {
      "tricube": {"r_eff_min": 0.35, "r_eff_max": 0.45},
      "gaussian": {"r_eff_min": 0.95, "r_eff_max": 1.05}
    }
  },

  "bootstrap": {
    "n_resamples": 0,
    "method": "query_resample",
    "seed": 101,
    "parallel": false
  },

  "theory": {
    "transition_sharpness_p": 2.0
  },

  "output": {
    "results_json": "results/eta_u_test.json",
    "figure": "results/figures/eta_u_test_main.png",
    "figure_overlay": "results/figures/eta_u_test_overlay.png",
    "table": "results/tables/eta_u_test_summary.csv"
  },

  "acceptance_criteria": {
    "fit_span_decades_min": 0.8,
    "middle_bin_eta_min": 2.5,
    "middle_bin_eta_max": 3.5,
    "weighted_eta_min": 2.4,
    "bootstrap_ci_width_max": 0.5,
    "locality_guard_pass_rate_min": 0.7
  }
}

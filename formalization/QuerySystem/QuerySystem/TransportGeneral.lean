/-
# Transport for the triangle carrier, and the cross-pair meeting lemma

Companion to `notes/open_questions/cyclic_marginal/definitions_draft.md` §16–20 and
`case_relativistic_triangle.md` (checks 3–4d).

* `mem_pre`: for ANY coordinatewise maps `f i : α → β`, the preimage of a carrier set over `β` is a
  carrier set over `α`. This is the transport lemma behind finite-quotient witnesses (values mod n)
  and behind pulling back carriers from smaller triangles. It generalises
  `TriangleCyclic.mem_pre` (inclusion ℕ → ℤ).
* `pairLocal_meet`: two pair-local sets on the pairs (0,1) and (1,2) of `Fin 3 → Fin n` meet as soon
  as `3 ≤ n` and each misses at most one value of the shared coordinate. This is the cross-pair step
  of Problem 3 (relations + relata stay pair-local); the remaining invariant is recorded in the notes.

Carrier here: the Dynkin system generated by all events `{x | (x i, x j) ∈ S}`, no measurability
structure needed.
-/
import Mathlib.MeasureTheory.PiSystem
import Mathlib.Tactic

open Set MeasurableSpace

namespace TransportGeneral

variable {α β : Type*}

/-- Pair events on `Fin 3 → α`. -/
def pairEvents (α : Type*) : Set (Set (Fin 3 → α)) :=
  {E | ∃ i j : Fin 3, ∃ S : Set (α × α), E = {x | (x i, x j) ∈ S}}

/-- The triangle carrier over `α`. -/
def carrier (α : Type*) : DynkinSystem (Fin 3 → α) := DynkinSystem.generate (pairEvents α)

/-- Apply coordinatewise maps. -/
def lift (f : Fin 3 → α → β) (x : Fin 3 → α) : Fin 3 → β := fun i => f i (x i)

lemma pre_pairEvent (f : Fin 3 → α → β) {E : Set (Fin 3 → β)} (hE : E ∈ pairEvents β) :
    lift f ⁻¹' E ∈ pairEvents α := by
  obtain ⟨i, j, S, rfl⟩ := hE
  exact ⟨i, j, (fun q : α × α => (f i q.1, f j q.2)) ⁻¹' S, rfl⟩

/-- **Transport.** Preimages of carrier sets under coordinatewise maps are carrier sets. -/
theorem mem_pre (f : Fin 3 → α → β) {E : Set (Fin 3 → β)} (hE : (carrier β).Has E) :
    (carrier α).Has (lift f ⁻¹' E) := by
  induction hE with
  | basic t ht => exact DynkinSystem.GenerateHas.basic _ (pre_pairEvent f ht)
  | empty => exact (carrier α).has_empty
  | @compl s _ ih => rw [preimage_compl]; exact (carrier α).has_compl ih
  | @iUnion g hd _ ih =>
    rw [preimage_iUnion]
    exact (carrier α).has_iUnion (fun i j hij => (hd hij).preimage _) ih

/-- Two subsets of `Fin n`, `3 ≤ n`, each missing at most one value, intersect. -/
lemma meet_of_almost_full {n : ℕ} (hn : 3 ≤ n) (U V : Set (Fin n))
    (hU : ∀ a b, a ≠ b → a ∈ U ∨ b ∈ U) (hV : ∀ a b, a ≠ b → a ∈ V ∨ b ∈ V) :
    (U ∩ V).Nonempty := by
  let a : Fin n := ⟨0, by omega⟩
  let b : Fin n := ⟨1, by omega⟩
  let c : Fin n := ⟨2, by omega⟩
  have hab : a ≠ b := by simp [a, b, Fin.ext_iff]
  have hac : a ≠ c := by simp [a, c, Fin.ext_iff]
  have hbc : b ≠ c := by simp [b, c, Fin.ext_iff]
  by_contra h
  have key : ∀ x, x ∈ U → x ∈ V → False := fun x hu hv => h ⟨x, hu, hv⟩
  have := hU a b hab; have := hU a c hac; have := hU b c hbc
  have := hV a b hab; have := hV a c hac; have := hV b c hbc
  have := key a; have := key b; have := key c
  tauto

/-- **Cross-pair meeting.** Pair-local sets on (0,1) and on (1,2) whose projections onto the shared
coordinate each miss at most one value have a common point, once `3 ≤ n`. -/
theorem pairLocal_meet {n : ℕ} (hn : 3 ≤ n) (S T : Set (Fin n × Fin n))
    (hS : ∀ a b, a ≠ b → (∃ u, (u, a) ∈ S) ∨ (∃ u, (u, b) ∈ S))
    (hT : ∀ a b, a ≠ b → (∃ w, (a, w) ∈ T) ∨ (∃ w, (b, w) ∈ T)) :
    ({x : Fin 3 → Fin n | (x 0, x 1) ∈ S} ∩ {x | (x 1, x 2) ∈ T}).Nonempty := by
  obtain ⟨a, ⟨u, hu⟩, ⟨w, hw⟩⟩ :=
    meet_of_almost_full hn {a | ∃ u, (u, a) ∈ S} {a | ∃ w, (a, w) ∈ T} hS hT
  exact ⟨![u, a, w], hu, hw⟩

/-! ## Problem 3, Lemma 2: at most one empty row

A pair-set in normal form `A(x,y) = k(cmp x y) ⊕ α x ⊕ β y` (comparison pattern, whole rows and whole
columns flipped). If two distinct rows are empty and `3 ≤ n`, then `A` does not depend on `y`. So a set
depending on both coordinates has at most one empty row (hence its projection misses ≤ 1 value). -/

namespace PairNormalForm

/-- Comparison code: 0 for `<`, 1 for `=`, 2 for `>`. -/
def cmpc {n : ℕ} (a b : Fin n) : Fin 3 := if a < b then 0 else if a = b then 1 else 2

/-- The normal-form set, as a Boolean function. -/
def nf {n : ℕ} (k : Fin 3 → Bool) (α β : Fin n → Bool) (x y : Fin n) : Bool :=
  xor (k (cmpc x y)) (xor (α x) (β y))

lemma cmpc_self {n : ℕ} (a : Fin n) : cmpc a a = 1 := by simp [cmpc]
lemma cmpc_lt {n : ℕ} {a b : Fin n} (h : a < b) : cmpc a b = 0 := by simp [cmpc, h]
lemma cmpc_gt {n : ℕ} {a b : Fin n} (h : b < a) : cmpc a b = 2 := by
  simp [cmpc, not_lt.mpr h.le, h.ne']

lemma xor_false_iff (p q r : Bool) : xor p (xor q r) = false ↔ r = xor p q := by
  cases p <;> cases q <;> cases r <;> decide

/-- Pure Boolean core: the three row comparisons force a constant comparison pattern. -/
lemma core (k0 k1 k2 p q ba ba' bc : Bool)
    (c1 : xor k1 (xor p ba) = false) (c2 : xor k2 (xor q ba) = false)
    (c3 : xor k0 (xor p ba') = false) (c4 : xor k1 (xor q ba') = false)
    (third : (xor k2 (xor p bc) = false ∧ xor k2 (xor q bc) = false) ∨
             (xor k0 (xor p bc) = false ∧ xor k2 (xor q bc) = false) ∨
             (xor k0 (xor p bc) = false ∧ xor k0 (xor q bc) = false)) :
    k0 = k1 ∧ k1 = k2 := by
  revert c1 c2 c3 c4 third
  cases k0 <;> cases k1 <;> cases k2 <;> cases p <;> cases q <;> cases ba <;> cases ba' <;>
    cases bc <;> decide

lemma exists_third {n : ℕ} (hn : 3 ≤ n) (a a' : Fin n) : ∃ y, y ≠ a ∧ y ≠ a' := by
  by_contra h
  push_neg at h
  have : (Finset.univ : Finset (Fin n)) ⊆ {a, a'} := fun y _ => by
    by_cases hy : y = a
    · simp [hy]
    · simp [h y hy]
  have := Finset.card_le_card this
  simp only [Finset.card_univ, Fintype.card_fin] at this
  have := Finset.card_le_two (a := a) (b := a')
  omega

/-- Constant comparison pattern from two empty rows `a < a'`. -/
lemma k_const_of_lt {n : ℕ} (hn : 3 ≤ n) (k : Fin 3 → Bool) (α β : Fin n → Bool) {a a' : Fin n}
    (hlt : a < a') (ha : ∀ y, nf k α β a y = false) (ha' : ∀ y, nf k α β a' y = false) :
    k 0 = k 1 ∧ k 1 = k 2 := by
  obtain ⟨y, hya, hya'⟩ := exists_third hn a a'
  have c1 := ha a; have c2 := ha' a; have c3 := ha a'; have c4 := ha' a'
  have d1 := ha y; have d2 := ha' y
  simp only [nf, cmpc_self, cmpc_lt hlt, cmpc_gt hlt] at c1 c2 c3 c4
  refine core (k 0) (k 1) (k 2) (α a) (α a') (β a) (β a') (β y) c1 c2 c3 c4 ?_
  simp only [nf] at d1 d2
  rcases lt_or_gt_of_ne hya with h1 | h1
  · -- y < a < a'
    left; rw [cmpc_gt h1, cmpc_gt (h1.trans hlt)] at *; exact ⟨d1, d2⟩
  · rcases lt_or_gt_of_ne hya' with h2 | h2
    · right; left; rw [cmpc_lt h1, cmpc_gt h2] at *; exact ⟨d1, d2⟩
    · right; right; rw [cmpc_lt h1, cmpc_lt h2] at *; exact ⟨d1, d2⟩

/-- **Lemma 2.** Two distinct empty rows force independence of `y` (for `3 ≤ n`). -/
theorem indep_of_two_empty_rows {n : ℕ} (hn : 3 ≤ n) (k : Fin 3 → Bool) (α β : Fin n → Bool)
    {a a' : Fin n} (hne : a ≠ a') (ha : ∀ y, nf k α β a y = false)
    (ha' : ∀ y, nf k α β a' y = false) : ∀ x y y', nf k α β x y = nf k α β x y' := by
  have hk : k 0 = k 1 ∧ k 1 = k 2 := by
    rcases lt_or_gt_of_ne hne with h | h
    · exact k_const_of_lt hn k α β h ha ha'
    · exact k_const_of_lt hn k α β h ha' ha
  have hall : ∀ c : Fin 3, k c = k 0 := by
    intro c; fin_cases c
    · rfl
    · exact hk.1.symm
    · exact (hk.1.trans hk.2).symm
  have hb : ∀ y, β y = xor (k 0) (α a) := by
    intro y; have := ha y; simp only [nf, hall] at this; exact (xor_false_iff _ _ _).1 this
  intro x y y'
  simp only [nf, hall, hb]

end PairNormalForm

/-! ## r×s×2 theorem, rectangle step

The "all three equal" set on the yes/no triangle is buildable, by an explicit construction:
`E = complement ((A ⊔ B)ᶜ ⊔ C)` with `A = {x₀ = 0, x₁ = 0}`, `B = {x₁ = 1, x₂ = 1}`,
`C = {x₀ = 0, x₂ = 1} ⊆ A ⊔ B`. Pulling it back along coordinatewise indicator maps shows that the
rectangle-pair set `{(x₀∈P ∧ x₁∈Q ∧ x₂∈R) ∨ (x₀∉P ∧ x₁∉Q ∧ x₂∉R)}` is buildable over any value type.
This is step (b) of the r×s×2 theorem (`definitions_draft.md` §21). -/

section RectangleStep

/-- All three coordinates equal, over `Bool`. -/
def allEq : Set (Fin 3 → Bool) := {x | x 0 = x 1 ∧ x 1 = x 2}

lemma pe (i j : Fin 3) (S : Set (Bool × Bool)) :
    (carrier Bool).Has {x | (x i, x j) ∈ S} :=
  DynkinSystem.GenerateHas.basic _ ⟨i, j, S, rfl⟩

theorem allEq_mem : (carrier Bool).Has allEq := by
  classical
  let A : Set (Fin 3 → Bool) := {x | (x 0, x 1) ∈ ({(false, false)} : Set (Bool × Bool))}
  let B : Set (Fin 3 → Bool) := {x | (x 1, x 2) ∈ ({(true, true)} : Set (Bool × Bool))}
  let C : Set (Fin 3 → Bool) := {x | (x 0, x 2) ∈ ({(false, true)} : Set (Bool × Bool))}
  have hA : (carrier Bool).Has A := pe 0 1 _
  have hB : (carrier Bool).Has B := pe 1 2 _
  have hC : (carrier Bool).Has C := pe 0 2 _
  have hAB : Disjoint A B := by
    rw [Set.disjoint_left]; intro x hx hy
    simp only [A, B, Set.mem_setOf_eq, Set.mem_singleton_iff, Prod.mk.injEq] at hx hy
    rw [hx.2] at hy; exact Bool.false_ne_true hy.1
  have hU : (carrier Bool).Has (A ∪ B) := (carrier Bool).has_union hA hB hAB
  have hdisj : Disjoint (A ∪ B)ᶜ C := by
    rw [Set.disjoint_left]; intro x hx hc
    apply hx
    simp only [A, B, C, Set.mem_union, Set.mem_setOf_eq, Set.mem_singleton_iff, Prod.mk.injEq] at hc ⊢
    cases h1 : x 1
    · left; exact ⟨hc.1, rfl⟩
    · right; exact ⟨rfl, hc.2⟩
  have hV : (carrier Bool).Has ((A ∪ B)ᶜ ∪ C) := (carrier Bool).has_union hU.compl hC hdisj
  have heq : allEq = ((A ∪ B)ᶜ ∪ C)ᶜ := by
    ext x
    simp only [allEq, A, B, C, Set.mem_compl_iff, Set.mem_union, Set.mem_setOf_eq,
      Set.mem_singleton_iff, Prod.mk.injEq]
    cases x 0 <;> cases x 1 <;> cases x 2 <;> decide
  rw [heq]; exact hV.compl

/-- **Rectangle step.** For any value type and any sets `P Q R`, the set where the three
membership bits agree is buildable. -/
theorem rect_mem (P Q R : Set α) :
    (carrier α).Has {x | (x 0 ∈ P ∧ x 1 ∈ Q ∧ x 2 ∈ R) ∨ (x 0 ∉ P ∧ x 1 ∉ Q ∧ x 2 ∉ R)} := by
  classical
  let f : Fin 3 → α → Bool := fun i a => decide (a ∈ (![P, Q, R] i))
  have h := mem_pre f allEq_mem
  convert h using 1
  ext x
  simp only [allEq, lift, f, Set.mem_preimage, Set.mem_setOf_eq, Matrix.cons_val_zero,
    Matrix.cons_val_one, Matrix.head_cons, Matrix.cons_val_two, Matrix.tail_cons]
  by_cases h0 : x 0 ∈ P <;> by_cases h1 : x 1 ∈ Q <;> by_cases h2 : x 2 ∈ R <;> simp [h0, h1, h2]

end RectangleStep

/-! ## Problem 3, Lemma 1: the normal form contains the pair closure

`F` = sets of the form `{(x,y) | nf k α β x y = true}`. Rows, columns and comparison classes are in
`F`; `F` is closed under complement (flip `k`) and under disjoint unions (xor the parameters), so it
is a Dynkin system containing the generators. -/

namespace PairNormalForm

variable {n : ℕ}

/-- The normal-form family on a pair. -/
def NF (n : ℕ) : Set (Set (Fin n × Fin n)) :=
  {A | ∃ (k : Fin 3 → Bool) (α β : Fin n → Bool), A = {p | nf k α β p.1 p.2 = true}}

lemma nf_xor (k k' : Fin 3 → Bool) (α α' β β' : Fin n → Bool) (x y : Fin n) :
    xor (nf k α β x y) (nf k' α' β' x y) =
      nf (fun c => xor (k c) (k' c)) (fun a => xor (α a) (α' a)) (fun b => xor (β b) (β' b)) x y := by
  simp only [nf]; cases k (cmpc x y) <;> cases k' (cmpc x y) <;> cases α x <;> cases α' x <;>
    cases β y <;> cases β' y <;> rfl

lemma NF_compl {A : Set (Fin n × Fin n)} (h : A ∈ NF n) : Aᶜ ∈ NF n := by
  obtain ⟨k, α, β, rfl⟩ := h
  refine ⟨fun c => !k c, α, β, ?_⟩
  ext p; simp only [Set.mem_compl_iff, Set.mem_setOf_eq, nf]
  cases k (cmpc p.1 p.2) <;> cases α p.1 <;> cases β p.2 <;> simp

lemma NF_union {A B : Set (Fin n × Fin n)} (hA : A ∈ NF n) (hB : B ∈ NF n) (hd : Disjoint A B) :
    A ∪ B ∈ NF n := by
  obtain ⟨k, α, β, rfl⟩ := hA
  obtain ⟨k', α', β', rfl⟩ := hB
  refine ⟨fun c => xor (k c) (k' c), fun a => xor (α a) (α' a), fun b => xor (β b) (β' b), ?_⟩
  ext p
  have hp : nf k α β p.1 p.2 = true → nf k' α' β' p.1 p.2 = true → False :=
    fun h1 h2 => Set.disjoint_left.mp hd (show p ∈ {q : Fin n × Fin n | nf k α β q.1 q.2 = true} from h1) h2
  simp only [Set.mem_union, Set.mem_setOf_eq]
  rw [← nf_xor]
  cases h1 : nf k α β p.1 p.2 <;> cases h2 : nf k' α' β' p.1 p.2 <;> simp_all

lemma NF_empty : (∅ : Set (Fin n × Fin n)) ∈ NF n :=
  ⟨fun _ => false, fun _ => false, fun _ => false, by ext p; simp [nf]⟩

/-- Finite unions of pairwise disjoint `NF` sets are in `NF`. -/
lemma NF_finset_union (s : Finset ℕ) (f : ℕ → Set (Fin n × Fin n)) (hf : ∀ i, f i ∈ NF n)
    (hd : Pairwise (Function.onFun Disjoint f)) : (⋃ i ∈ s, f i) ∈ NF n := by
  induction s using Finset.induction_on with
  | empty => simpa using NF_empty
  | insert i s hi ih =>
    rw [Finset.set_biUnion_insert]
    refine NF_union (hf i) ih ?_
    rw [Set.disjoint_iUnion₂_right]
    intro j hj; exact hd (fun h => hi (h ▸ hj))

/-- Disjoint countable unions reduce to finite ones on a finite type. -/
lemma NF_iUnion (f : ℕ → Set (Fin n × Fin n)) (hf : ∀ i, f i ∈ NF n)
    (hd : Pairwise (Function.onFun Disjoint f)) : (⋃ i, f i) ∈ NF n := by
  classical
  -- each point lies in at most one f i; the union is the union over the finite set of indices
  -- realised by points
  let idx : Fin n × Fin n → Option ℕ := fun p =>
    if h : ∃ i, p ∈ f i then some (Nat.find h) else none
  let s : Finset ℕ := (Finset.univ.image idx).filterMap id (fun _ _ _ h1 h2 => by simp_all)
  have key : (⋃ i, f i) = ⋃ i ∈ s, f i := by
    ext p; simp only [Set.mem_iUnion]
    constructor
    · rintro ⟨i, hi⟩
      have hex : ∃ i, p ∈ f i := ⟨i, hi⟩
      refine ⟨Nat.find hex, ?_, Nat.find_spec hex⟩
      simp only [s, Finset.mem_filterMap, Finset.mem_image, Finset.mem_univ, true_and, id]
      exact ⟨some (Nat.find hex), ⟨p, by simp [idx, hex]⟩, rfl⟩
    · rintro ⟨i, -, hi⟩; exact ⟨i, hi⟩
  rw [key]; exact NF_finset_union s f hf hd

/-- `NF` as a Dynkin system. -/
def NFsys (n : ℕ) : DynkinSystem (Fin n × Fin n) where
  Has A := A ∈ NF n
  has_empty := NF_empty
  has_compl := NF_compl
  has_iUnion_nat hd hf := NF_iUnion _ hf hd

/-- Generators of the pair closure: rows, columns, comparison classes. -/
def pairGens (n : ℕ) : Set (Set (Fin n × Fin n)) :=
  {A | (∃ a, A = {p | p.1 = a}) ∨ (∃ b, A = {p | p.2 = b}) ∨ (∃ c, A = {p | cmpc p.1 p.2 = c})}

/-- **Lemma 1.** The pair closure is contained in the normal form. -/
theorem closure_le_NF {A : Set (Fin n × Fin n)} (h : (DynkinSystem.generate (pairGens n)).Has A) :
    A ∈ NF n := by
  classical
  have hgen : ∀ B ∈ pairGens n, B ∈ NF n := by
    rintro B (⟨a, rfl⟩ | ⟨b, rfl⟩ | ⟨c, rfl⟩)
    · exact ⟨fun _ => false, fun x => decide (x = a), fun _ => false, by ext p; simp [nf]⟩
    · exact ⟨fun _ => false, fun _ => false, fun y => decide (y = b), by ext p; simp [nf]⟩
    · exact ⟨fun c' => decide (c' = c), fun _ => false, fun _ => false, by ext p; simp [nf]⟩
  exact (DynkinSystem.generate_le (NFsys n) hgen) A h

end PairNormalForm

end TransportGeneral


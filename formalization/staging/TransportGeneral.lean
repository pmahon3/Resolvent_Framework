/-
# Transport for the triangle carrier, and the cross-pair meeting lemma

Companion to `notes/open_questions/cyclic_marginal/definitions_draft.md` §16–20 and
`case_relativistic_triangle.md` (checks 3–4d).

* `mem_pre`: for ANY coordinatewise maps `f i : α → β`, the preimage of a carrier set over `β` is a
  carrier set over `α`. This is the transport lemma behind finite-quotient witnesses (values mod n)
  and behind pulling back carriers from smaller triangles. It generalises
  `TriangleCyclic.mem_pre` (inclusion ℕ → ℤ).
* `pairLocal_meet`: two pair-local sets on the pairs (0,1) and (1,2) of `Fin 3 → Fin n` meet as soon
  as `3 ≤ n` and each misses at most one value of the shared coordinate. This is the cross-pair step
  of Problem 3 (relations + relata stay pair-local); the remaining invariant is recorded in the notes.

Carrier here: the Dynkin system generated by all events `{x | (x i, x j) ∈ S}`, no measurability
structure needed.
-/
import Mathlib.MeasureTheory.PiSystem
import Mathlib.Tactic

open Set MeasurableSpace

namespace TransportGeneral

variable {α β : Type*}

/-- Pair events on `Fin 3 → α`. -/
def pairEvents (α : Type*) : Set (Set (Fin 3 → α)) :=
  {E | ∃ i j : Fin 3, ∃ S : Set (α × α), E = {x | (x i, x j) ∈ S}}

/-- The triangle carrier over `α`. -/
def carrier (α : Type*) : DynkinSystem (Fin 3 → α) := DynkinSystem.generate (pairEvents α)

/-- Apply coordinatewise maps. -/
def lift (f : Fin 3 → α → β) (x : Fin 3 → α) : Fin 3 → β := fun i => f i (x i)

lemma pre_pairEvent (f : Fin 3 → α → β) {E : Set (Fin 3 → β)} (hE : E ∈ pairEvents β) :
    lift f ⁻¹' E ∈ pairEvents α := by
  obtain ⟨i, j, S, rfl⟩ := hE
  exact ⟨i, j, (fun q : α × α => (f i q.1, f j q.2)) ⁻¹' S, rfl⟩

/-- **Transport.** Preimages of carrier sets under coordinatewise maps are carrier sets. -/
theorem mem_pre (f : Fin 3 → α → β) {E : Set (Fin 3 → β)} (hE : (carrier β).Has E) :
    (carrier α).Has (lift f ⁻¹' E) := by
  induction hE with
  | basic t ht => exact DynkinSystem.GenerateHas.basic _ (pre_pairEvent f ht)
  | empty => exact (carrier α).has_empty
  | @compl s _ ih => rw [preimage_compl]; exact (carrier α).has_compl ih
  | @iUnion g hd _ ih =>
    rw [preimage_iUnion]
    exact (carrier α).has_iUnion (fun i j hij => (hd hij).preimage _) ih

/-- Two subsets of `Fin n`, `3 ≤ n`, each missing at most one value, intersect. -/
lemma meet_of_almost_full {n : ℕ} (hn : 3 ≤ n) (U V : Set (Fin n))
    (hU : ∀ a b, a ≠ b → a ∈ U ∨ b ∈ U) (hV : ∀ a b, a ≠ b → a ∈ V ∨ b ∈ V) :
    (U ∩ V).Nonempty := by
  let a : Fin n := ⟨0, by omega⟩
  let b : Fin n := ⟨1, by omega⟩
  let c : Fin n := ⟨2, by omega⟩
  have hab : a ≠ b := by simp [a, b, Fin.ext_iff]
  have hac : a ≠ c := by simp [a, c, Fin.ext_iff]
  have hbc : b ≠ c := by simp [b, c, Fin.ext_iff]
  by_contra h
  have key : ∀ x, x ∈ U → x ∈ V → False := fun x hu hv => h ⟨x, hu, hv⟩
  have := hU a b hab; have := hU a c hac; have := hU b c hbc
  have := hV a b hab; have := hV a c hac; have := hV b c hbc
  have := key a; have := key b; have := key c
  tauto

/-- **Cross-pair meeting.** Pair-local sets on (0,1) and on (1,2) whose projections onto the shared
coordinate each miss at most one value have a common point, once `3 ≤ n`. -/
theorem pairLocal_meet {n : ℕ} (hn : 3 ≤ n) (S T : Set (Fin n × Fin n))
    (hS : ∀ a b, a ≠ b → (∃ u, (u, a) ∈ S) ∨ (∃ u, (u, b) ∈ S))
    (hT : ∀ a b, a ≠ b → (∃ w, (a, w) ∈ T) ∨ (∃ w, (b, w) ∈ T)) :
    ({x : Fin 3 → Fin n | (x 0, x 1) ∈ S} ∩ {x | (x 1, x 2) ∈ T}).Nonempty := by
  obtain ⟨a, ⟨u, hu⟩, ⟨w, hw⟩⟩ :=
    meet_of_almost_full hn {a | ∃ u, (u, a) ∈ S} {a | ∃ w, (a, w) ∈ T} hS hT
  exact ⟨![u, a, w], hu, hw⟩

end TransportGeneral

#print axioms TransportGeneral.mem_pre
#print axioms TransportGeneral.pairLocal_meet

/-- Functional of the family `dpp`. -/
noncomputable def s_dpp (p : Ultrafilter ℕ) (E : Set Ω) : ℤ := Wv p t01_2 E - Wv p o102 E + Wv p o120 E

theorem s_dpp_mem {E : Set Ω} (hE : D₃.Has E) : s_dpp p E = 0 ∨ s_dpp p E = 1 := by

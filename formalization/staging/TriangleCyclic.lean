/-
# The cyclic set is not in the triangle carrier over ℕ

Companion to `notes/open_questions/delay_embedding/collision_vs_generation.md`
(Triangle probe, "Theorem: E* is not in the carrier") and to
`notes/open_questions/cyclic_marginal/glued_carriers_taxonomy.json`
(`thm.triangle_estar_not_built`).

Setup. Ω = ℕ³ with the three pair windows {0,1}, {1,2}, {2,0}. The carrier `D₃` is the
Dynkin system generated by the window events (same construction as `glued` in
`WindowGluing.lean`, specialised to the triangle).

Result (`estar_not_mem`). The set
  E* = {x | [x₀ ≤ x₁] + [x₁ < x₂] + [x₂ < x₀] = 2}
is not in `D₃`. More generally (`not_inF_of_mem`) no set that agrees with the strict-cyclic
set, or with the strict-anticyclic set, at all points whose three pairwise gaps exceed some
n lies in `D₃`.

Method.
* Every set of `D₃` satisfies the eight-corner box identity (`box_of_mem`): window events do,
  and the identity survives complements and countable disjoint unions.
* Lift lemma (`lift0/1/2`): if G satisfies the box identity and avoids the far anticyclic
  points, then lifting the minimum coordinate of a far cyclic point far above the maximum does
  not change membership. The other six corners of the box are far anticyclic points.
* Hence membership is constant on far cyclic points (`const_cyc`), and by the reflection
  (x₀,x₂,x₁) on far anticyclic points (`const_acy`).
* Induction over the Dynkin system: a countable disjoint union has exactly one piece that takes
  the far part, and that piece would already be a member of the family.
Independent of any ultrafilter.

Layer 1 (`not_inP_of_mem`): the same holds for the homogeneous-set family: sets agreeing with
the cyclic (or anticyclic) set on the distinct points of P³ for some infinite P.

Layer 2 (`triangle_pointless_state`, `triangle_has_pointless_state`): for a non-principal
ultrafilter p, `sstar p = W₀₁₂ + W₁₂₀ − W₁₀₂` (iterated-limit ultrafilters along three placements)
is finitely additive, normalised, {0,1}-valued on D₃, and equals 1 on the staircase steps
C₀, C₁, C₂ with C₀ ∩ C₁ ∩ C₂ = ∅, so no ultrafilter on Ω reproduces it: the triangle carries a
pointless state. Two-valuedness: a bad value forces (ultrafilter Ramsey for triples, `ramsey3`,
plus two box identities, `pat_arith`) the cyclic or anticyclic pattern on an infinite P.
-/
import Mathlib.MeasureTheory.PiSystem
import Mathlib.MeasureTheory.MeasurableSpace.Pi
import Mathlib.Topology.Algebra.InfiniteSum.ENNReal
import Mathlib.Tactic.FinCases
import Mathlib.Data.Nat.Nth
import Mathlib.Order.Filter.Ultrafilter.Basic
import Mathlib.Order.Filter.Finite
import Mathlib.Order.Filter.Cofinite

open Set MeasurableSpace Function
open scoped ENNReal

namespace TriangleCyclic

abbrev Ω := Fin 3 → ℕ

/-- Events of window `w`: pulled back along restriction to the coordinates in `w`. -/
abbrev windowSigma (w : Set (Fin 3)) : MeasurableSpace Ω :=
  MeasurableSpace.comap (fun x (k : w) => x k) MeasurableSpace.pi

/-- The triangle: three pair windows. -/
def W₃ : Set (Set (Fin 3)) := {{0, 1}, {1, 2}, {2, 0}}

def gens : Set (Set Ω) := {E | ∃ w ∈ W₃, @MeasurableSet _ (windowSigma w) E}

/-- The triangle carrier over ℕ. -/
def D₃ : DynkinSystem Ω := DynkinSystem.generate gens

lemma window_event_local {w : Set (Fin 3)} {E : Set Ω}
    (hE : @MeasurableSet _ (windowSigma w) E) {y z : Ω} (h : ∀ k ∈ w, y k = z k) :
    y ∈ E ↔ z ∈ E := by
  obtain ⟨s, -, rfl⟩ := hE
  have : (fun (k : w) => y k) = (fun (k : w) => z k) := funext fun k => h k k.2
  simp only [mem_preimage, this]

@[simp] lemma v0 (a b c : ℕ) : (![a, b, c] : Ω) 0 = a := rfl
@[simp] lemma v1 (a b c : ℕ) : (![a, b, c] : Ω) 1 = b := rfl
@[simp] lemma v2 (a b c : ℕ) : (![a, b, c] : Ω) 2 = c := rfl

lemma eta (x : Ω) : x = ![x 0, x 1, x 2] := by
  ext i; fin_cases i <;> rfl

/-! ## Counts and the box identity -/

noncomputable def cnt (E : Set Ω) (p : Ω) : ℕ := by
  classical exact if p ∈ E then 1 else 0

lemma cnt_le (E : Set Ω) (p : Ω) : cnt E p ≤ 1 := by
  unfold cnt; split_ifs <;> omega

lemma cnt_compl (E : Set Ω) (p : Ω) : cnt Eᶜ p = 1 - cnt E p := by
  unfold cnt; by_cases h : p ∈ E <;> simp [h]

lemma cnt_congr {E : Set Ω} {p q : Ω} (h : p ∈ E ↔ q ∈ E) : cnt E p = cnt E q := by
  unfold cnt
  by_cases hp : p ∈ E
  · simp [hp, h.mp hp]
  · simp [hp, (not_congr h).mp hp]

lemma cast_cnt_iUnion {f : ℕ → Set Ω} (hd : Pairwise (Disjoint on f)) (p : Ω) :
    ((cnt (⋃ n, f n) p : ℕ) : ℝ≥0∞) = ∑' n, ((cnt (f n) p : ℕ) : ℝ≥0∞) := by
  classical
  by_cases hp : p ∈ ⋃ n, f n
  · obtain ⟨k, hk⟩ := mem_iUnion.mp hp
    rw [tsum_eq_single k]
    · simp [cnt, hp, hk]
    · intro n hn
      have : p ∉ f n := fun h' => Set.disjoint_left.mp (hd hn) h' hk
      simp [cnt, this]
  · have : ∀ n, p ∉ f n := fun n h' => hp (mem_iUnion.mpr ⟨n, h'⟩)
    simp [cnt, hp, this]

/-- The eight-corner box identity (vanishing triple interaction), in counts. -/
def Box (E : Set Ω) : Prop :=
  ∀ a a' b b' c c' : ℕ,
    cnt E ![a, b, c] + cnt E ![a', b', c] + cnt E ![a', b, c'] + cnt E ![a, b', c'] =
      cnt E ![a', b, c] + cnt E ![a, b', c] + cnt E ![a, b, c'] + cnt E ![a', b', c']

lemma box_of_gens {E : Set Ω} (hE : E ∈ gens) : Box E := by
  obtain ⟨w, hw, hE⟩ := hE
  intro a a' b b' c c'
  rcases hw with rfl | rfl | rfl
  · -- window {0,1}: membership ignores x₂
    have h : ∀ x y z z' : ℕ, cnt E ![x, y, z] = cnt E ![x, y, z'] := by
      intro x y z z'
      have := window_event_local hE (y := ![x, y, z]) (z := ![x, y, z'])
        (by intro k hk; simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hk
            rcases hk with rfl | rfl <;> rfl)
      exact cnt_congr this
    have := h a' b c' c; have := h a b' c' c; have := h a b c' c; have := h a' b' c' c; omega
  · -- window {1,2}: membership ignores x₀
    have h : ∀ x x' y z : ℕ, cnt E ![x, y, z] = cnt E ![x', y, z] := by
      intro x x' y z
      have := window_event_local hE (y := ![x, y, z]) (z := ![x', y, z])
        (by intro k hk; simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hk
            rcases hk with rfl | rfl <;> rfl)
      exact cnt_congr this
    have := h a' a b' c; have := h a' a b c'; have := h a' a b c; have := h a' a b' c'; omega
  · -- window {2,0}: membership ignores x₁
    have h : ∀ x y y' z : ℕ, cnt E ![x, y, z] = cnt E ![x, y', z] := by
      intro x y y' z
      have := window_event_local hE (y := ![x, y, z]) (z := ![x, y', z])
        (by intro k hk; simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hk
            rcases hk with rfl | rfl <;> rfl)
      exact cnt_congr this
    have := h a' b' b c; have := h a b' b c'; have := h a b' b c; have := h a' b' b c'; omega

/-- Every set of the triangle carrier satisfies the box identity. -/
theorem box_of_mem {E : Set Ω} (hE : D₃.Has E) : Box E := by
  induction hE with
  | basic t ht => exact box_of_gens ht
  | empty => intro a a' b b' c c'; simp [cnt]
  | @compl s _ ih =>
    intro a a' b b' c c'
    have h := ih a a' b b' c c'
    simp only [cnt_compl]
    have := cnt_le s ![a, b, c]; have := cnt_le s ![a', b', c]
    have := cnt_le s ![a', b, c']; have := cnt_le s ![a, b', c']
    have := cnt_le s ![a', b, c]; have := cnt_le s ![a, b', c]
    have := cnt_le s ![a, b, c']; have := cnt_le s ![a', b', c']
    omega
  | iUnion hd _ ih =>
    intro a a' b b' c c'
    apply Nat.cast_injective (R := ℝ≥0∞)
    push_cast
    simp only [cast_cnt_iUnion hd]
    rw [← ENNReal.tsum_add, ← ENNReal.tsum_add, ← ENNReal.tsum_add,
      ← ENNReal.tsum_add, ← ENNReal.tsum_add, ← ENNReal.tsum_add]
    congr 1; ext n
    exact_mod_cast ih n a a' b b' c c'

/-! ## Far points, cyclic and anticyclic -/

/-- All three pairwise gaps exceed `n`. -/
def Far (n : ℕ) (x : Ω) : Prop :=
  (x 0 + n < x 1 ∨ x 1 + n < x 0) ∧ (x 1 + n < x 2 ∨ x 2 + n < x 1) ∧
    (x 2 + n < x 0 ∨ x 0 + n < x 2)

/-- Strict cyclic order: x₀<x₁<x₂ or a rotation. -/
def Cyc (x : Ω) : Prop :=
  (x 0 < x 1 ∧ x 1 < x 2) ∨ (x 1 < x 2 ∧ x 2 < x 0) ∨ (x 2 < x 0 ∧ x 0 < x 1)

/-- Strict anticyclic order. -/
def Acy (x : Ω) : Prop :=
  (x 0 < x 2 ∧ x 2 < x 1) ∨ (x 2 < x 1 ∧ x 1 < x 0) ∨ (x 1 < x 0 ∧ x 0 < x 2)

lemma far_mono {m n : ℕ} (h : m ≤ n) {x : Ω} (hx : Far n x) : Far m x := by
  unfold Far at *; omega

lemma far_cyc_or_acy {n : ℕ} {x : Ω} (hx : Far n x) : Cyc x ∨ Acy x := by
  unfold Far Cyc Acy at *; omega

lemma not_cyc_and_acy (x : Ω) : ¬ (Cyc x ∧ Acy x) := by
  unfold Cyc Acy; omega

/-- The family: sets agreeing with the cyclic (or anticyclic) set at all far points. -/
def InF (G : Set Ω) : Prop :=
  ∃ n, (∀ x, Far n x → (x ∈ G ↔ Cyc x)) ∨ (∀ x, Far n x → (x ∈ G ↔ Acy x))

/-! ## The lift lemma -/

section Lift

variable {G : Set Ω} {n : ℕ} (hB : Box G) (hA : ∀ x, Far n x → Acy x → x ∉ G)
include hB hA

omit hB in
lemma cnt_zero {x : Ω} (hF : Far n x) (hx : Acy x) : cnt G x = 0 := by
  simp [cnt, hA x hF hx]

/-- Lift x₀ (the minimum of a 012-point) far above the maximum. -/
lemma lift0 {a b c a' : ℕ} (hab : a + (2 * n + 1) < b) (hbc : b + (2 * n + 1) < c)
    (ha' : c + (2 * n + 1) < a') : cnt G ![a, b, c] = cnt G ![a', b, c] := by
  have h := hB a a' b (c + n + 1) c (a + n + 1)
  have z1 : cnt G ![a', c + n + 1, c] = 0 :=
    cnt_zero hA (by simp only [Far, v0, v1, v2]; omega) (by simp only [Acy, v0, v1, v2]; omega)
  have z2 : cnt G ![a', b, a + n + 1] = 0 :=
    cnt_zero hA (by simp only [Far, v0, v1, v2]; omega) (by simp only [Acy, v0, v1, v2]; omega)
  have z3 : cnt G ![a, c + n + 1, a + n + 1] = 0 :=
    cnt_zero hA (by simp only [Far, v0, v1, v2]; omega) (by simp only [Acy, v0, v1, v2]; omega)
  have z4 : cnt G ![a, c + n + 1, c] = 0 :=
    cnt_zero hA (by simp only [Far, v0, v1, v2]; omega) (by simp only [Acy, v0, v1, v2]; omega)
  have z5 : cnt G ![a, b, a + n + 1] = 0 :=
    cnt_zero hA (by simp only [Far, v0, v1, v2]; omega) (by simp only [Acy, v0, v1, v2]; omega)
  have z6 : cnt G ![a', c + n + 1, a + n + 1] = 0 :=
    cnt_zero hA (by simp only [Far, v0, v1, v2]; omega) (by simp only [Acy, v0, v1, v2]; omega)
  omega

/-- Lift x₁ (the minimum of a 120-point (c,a,b), a<b<c) far above the maximum. -/
lemma lift1 {a b c a' : ℕ} (hab : a + (2 * n + 1) < b) (hbc : b + (2 * n + 1) < c)
    (ha' : c + (2 * n + 1) < a') : cnt G ![c, a, b] = cnt G ![c, a', b] := by
  have h := hB c (a + n + 1) a a' b (c + n + 1)
  have z1 : cnt G ![a + n + 1, a', b] = 0 :=
    cnt_zero hA (by simp only [Far, v0, v1, v2]; omega) (by simp only [Acy, v0, v1, v2]; omega)
  have z2 : cnt G ![a + n + 1, a, c + n + 1] = 0 :=
    cnt_zero hA (by simp only [Far, v0, v1, v2]; omega) (by simp only [Acy, v0, v1, v2]; omega)
  have z3 : cnt G ![c, a', c + n + 1] = 0 :=
    cnt_zero hA (by simp only [Far, v0, v1, v2]; omega) (by simp only [Acy, v0, v1, v2]; omega)
  have z4 : cnt G ![a + n + 1, a, b] = 0 :=
    cnt_zero hA (by simp only [Far, v0, v1, v2]; omega) (by simp only [Acy, v0, v1, v2]; omega)
  have z5 : cnt G ![c, a, c + n + 1] = 0 :=
    cnt_zero hA (by simp only [Far, v0, v1, v2]; omega) (by simp only [Acy, v0, v1, v2]; omega)
  have z6 : cnt G ![a + n + 1, a', c + n + 1] = 0 :=
    cnt_zero hA (by simp only [Far, v0, v1, v2]; omega) (by simp only [Acy, v0, v1, v2]; omega)
  omega

/-- Lift x₂ (the minimum of a 201-point (b,c,a), a<b<c) far above the maximum. -/
lemma lift2 {a b c a' : ℕ} (hab : a + (2 * n + 1) < b) (hbc : b + (2 * n + 1) < c)
    (ha' : c + (2 * n + 1) < a') : cnt G ![b, c, a] = cnt G ![b, c, a'] := by
  have h := hB b (c + n + 1) c (a + n + 1) a a'
  have z1 : cnt G ![c + n + 1, a + n + 1, a] = 0 :=
    cnt_zero hA (by simp only [Far, v0, v1, v2]; omega) (by simp only [Acy, v0, v1, v2]; omega)
  have z2 : cnt G ![c + n + 1, c, a'] = 0 :=
    cnt_zero hA (by simp only [Far, v0, v1, v2]; omega) (by simp only [Acy, v0, v1, v2]; omega)
  have z3 : cnt G ![b, a + n + 1, a'] = 0 :=
    cnt_zero hA (by simp only [Far, v0, v1, v2]; omega) (by simp only [Acy, v0, v1, v2]; omega)
  have z4 : cnt G ![c + n + 1, c, a] = 0 :=
    cnt_zero hA (by simp only [Far, v0, v1, v2]; omega) (by simp only [Acy, v0, v1, v2]; omega)
  have z5 : cnt G ![b, a + n + 1, a] = 0 :=
    cnt_zero hA (by simp only [Far, v0, v1, v2]; omega) (by simp only [Acy, v0, v1, v2]; omega)
  have z6 : cnt G ![c + n + 1, a + n + 1, a'] = 0 :=
    cnt_zero hA (by simp only [Far, v0, v1, v2]; omega) (by simp only [Acy, v0, v1, v2]; omega)
  omega

/-- The reference point `R K`. -/
def R (n K : ℕ) : Ω := ![K, K + (2 * n + 2), K + 2 * (2 * n + 2)]

lemma reach012 {a b c : ℕ} (hab : a + (2 * n + 1) < b) (hbc : b + (2 * n + 1) < c)
    {K : ℕ} (hK : c + (2 * n + 1) < K) : cnt G ![a, b, c] = cnt G (R n K) := by
  rw [lift0 hB hA hab hbc hK,
    lift1 hB hA (a' := K + (2 * n + 2)) hbc hK (by omega),
    lift2 hB hA (a' := K + 2 * (2 * n + 2)) hK (by omega) (by omega)]
  rfl

lemma reach201 {a b c : ℕ} (hab : a + (2 * n + 1) < b) (hbc : b + (2 * n + 1) < c)
    {K : ℕ} (hK : c + (2 * n + 2) + (2 * n + 1) < K) : cnt G ![b, c, a] = cnt G (R n K) := by
  rw [lift2 hB hA (a' := c + (2 * n + 2)) hab hbc (by omega)]
  exact reach012 hB hA hbc (by omega) hK

lemma reach120 {a b c : ℕ} (hab : a + (2 * n + 1) < b) (hbc : b + (2 * n + 1) < c)
    {K : ℕ} (hK : c + (2 * n + 2) + (2 * n + 2) + (2 * n + 1) < K) :
    cnt G ![c, a, b] = cnt G (R n K) := by
  rw [lift1 hB hA (a' := c + (2 * n + 2)) hab hbc (by omega)]
  exact reach201 hB hA (a := b) (b := c) (c := c + (2 * n + 2)) hbc (by omega) (by omega)

/-- Every far cyclic point has the count of `R K` for all large `K`. -/
lemma reach {p : Ω} (hF : Far (2 * n + 1) p) (hC : Cyc p) :
    ∃ K₀, ∀ K, K₀ < K → cnt G p = cnt G (R n K) := by
  rw [eta p]
  unfold Far Cyc at *
  rcases hC with ⟨h1, h2⟩ | ⟨h1, h2⟩ | ⟨h1, h2⟩
  · exact ⟨p 2 + (2 * n + 1), fun K hK => reach012 hB hA (by omega) (by omega) hK⟩
  · exact ⟨p 0 + (2 * n + 2) + (2 * n + 2) + (2 * n + 1),
      fun K hK => reach120 hB hA (by omega) (by omega) hK⟩
  · exact ⟨p 1 + (2 * n + 2) + (2 * n + 1), fun K hK => reach201 hB hA (by omega) (by omega) hK⟩

/-- **Constancy on far cyclic points.** -/
theorem const_cyc {p q : Ω} (hp : Far (2 * n + 1) p) (hpc : Cyc p)
    (hq : Far (2 * n + 1) q) (hqc : Cyc q) : cnt G p = cnt G q := by
  obtain ⟨K₁, h₁⟩ := reach hB hA hp hpc
  obtain ⟨K₂, h₂⟩ := reach hB hA hq hqc
  rw [h₁ (K₁ + K₂ + 1) (by omega), h₂ (K₁ + K₂ + 1) (by omega)]

end Lift

/-! ## The reflection (x₀, x₂, x₁) -/

def ρ (x : Ω) : Ω := ![x 0, x 2, x 1]

lemma ρρ (x : Ω) : ρ (ρ x) = x := by
  ext i; fin_cases i <;> rfl

lemma cnt_pre (G : Set Ω) (y : Ω) : cnt {x | ρ x ∈ G} y = cnt G (ρ y) := rfl

lemma ρ_vec (a b c : ℕ) : ρ ![a, b, c] = ![a, c, b] := rfl

lemma box_refl {G : Set Ω} (hB : Box G) : Box {x | ρ x ∈ G} := by
  intro a a' b b' c c'
  have h := hB a a' c c' b b'
  simp only [cnt_pre, ρ_vec]
  omega

theorem const_acy {G : Set Ω} {n : ℕ} (hB : Box G) (hC : ∀ x, Far n x → Cyc x → x ∉ G)
    {p q : Ω} (hp : Far (2 * n + 1) p) (hpa : Acy p)
    (hq : Far (2 * n + 1) q) (hqa : Acy q) : cnt G p = cnt G q := by
  have hA' : ∀ x, Far n x → Acy x → x ∉ {x | ρ x ∈ G} := by
    intro x hF hx
    exact hC (ρ x) (by unfold Far ρ at *; simp only [v0, v1, v2]; omega)
      (by unfold Acy at hx; unfold Cyc ρ; simp only [v0, v1, v2]; omega)
  have key := const_cyc (box_refl hB) hA' (p := ρ p) (q := ρ q)
    (by unfold Far ρ at *; simp only [v0, v1, v2]; omega)
    (by unfold Acy at hpa; unfold Cyc ρ; simp only [v0, v1, v2]; omega)
    (by unfold Far ρ at *; simp only [v0, v1, v2]; omega)
    (by unfold Acy at hqa; unfold Cyc ρ; simp only [v0, v1, v2]; omega)
  rwa [cnt_pre, cnt_pre, ρρ, ρρ] at key

/-! ## The main theorem -/

lemma not_inF_empty : ¬ InF (∅ : Set Ω) := by
  rintro ⟨n, h | h⟩
  · have := (h ![0, n + 1, 2 * n + 2] (by simp only [Far, v0, v1, v2]; omega)).mpr
      (by simp only [Cyc, v0, v1, v2]; omega)
    exact this
  · have := (h ![0, 2 * n + 2, n + 1] (by simp only [Far, v0, v1, v2]; omega)).mpr
      (by simp only [Acy, v0, v1, v2]; omega)
    exact this

lemma inF_of_inF_compl {E : Set Ω} (h : InF Eᶜ) : InF E := by
  obtain ⟨n, h | h⟩ := h
  · refine ⟨n, Or.inr fun x hx => ?_⟩
    have := h x hx; have hca := far_cyc_or_acy hx; have hn := not_cyc_and_acy x
    simp only [mem_compl_iff] at this
    constructor
    · intro hxE; rcases hca with hc | ha
      · exact absurd hxE (this.mpr hc)
      · exact ha
    · intro ha; by_contra hxE; exact hn ⟨this.mp hxE, ha⟩
  · refine ⟨n, Or.inl fun x hx => ?_⟩
    have := h x hx; have hca := far_cyc_or_acy hx; have hn := not_cyc_and_acy x
    simp only [mem_compl_iff] at this
    constructor
    · intro hxE; rcases hca with hc | ha
      · exact hc
      · exact absurd hxE (this.mpr ha)
    · intro hc; by_contra hxE; exact hn ⟨hc, this.mp hxE⟩

lemma not_inF_gens {E : Set Ω} (hE : E ∈ gens) : ¬ InF E := by
  obtain ⟨w, hw, hE⟩ := hE
  rintro ⟨n, h⟩
  -- two far points, one cyclic and one anticyclic, that the window cannot tell apart
  have key : ∀ P Q : Ω, (P ∈ E ↔ Q ∈ E) → Far n P → Far n Q → Acy P → Cyc Q → False := by
    intro P Q hPQ hP hQ hPa hQc
    rcases h with h | h
    · have := (h P hP).mp (hPQ.mpr ((h Q hQ).mpr hQc)); exact not_cyc_and_acy P ⟨this, hPa⟩
    · have := (h Q hQ).mp (hPQ.mp ((h P hP).mpr hPa)); exact not_cyc_and_acy Q ⟨hQc, this⟩
  have loc : ∀ y z : Ω, (∀ k ∈ w, y k = z k) → (y ∈ E ↔ z ∈ E) :=
    fun y z hyz => window_event_local hE hyz
  rcases hw with rfl | rfl | rfl
  · refine key ![0, 3 * (n + 1), n + 1] ![0, 3 * (n + 1), 4 * (n + 1)] (loc _ _ ?_) ?_ ?_ ?_ ?_
    · intro k hk; simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hk
      rcases hk with rfl | rfl <;> rfl
    all_goals simp only [Far, Cyc, Acy, v0, v1, v2]; omega
  · refine key ![n + 1, 0, 3 * (n + 1)] ![4 * (n + 1), 0, 3 * (n + 1)] (loc _ _ ?_) ?_ ?_ ?_ ?_
    · intro k hk; simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hk
      rcases hk with rfl | rfl <;> rfl
    all_goals simp only [Far, Cyc, Acy, v0, v1, v2]; omega
  · refine key ![0, 4 * (n + 1), 3 * (n + 1)] ![0, n + 1, 3 * (n + 1)] (loc _ _ ?_) ?_ ?_ ?_ ?_
    · intro k hk; simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hk
      rcases hk with rfl | rfl <;> rfl
    all_goals simp only [Far, Cyc, Acy, v0, v1, v2]; omega

/-- **No member of the family is in the triangle carrier.** -/
theorem not_inF_of_mem {E : Set Ω} (hE : D₃.Has E) : ¬ InF E := by
  induction hE with
  | basic t ht => exact not_inF_gens ht
  | empty => exact not_inF_empty
  | compl _ ih => exact fun h => ih (inF_of_inF_compl h)
  | @iUnion f hd hf ih =>
    rintro ⟨n, hZ | hZ⟩
    · -- cyclic side: the piece containing a far cyclic base point takes all far cyclic points
      have hA : ∀ i x, Far n x → Acy x → x ∉ f i := fun i x hx ha hxi =>
        not_cyc_and_acy x ⟨(hZ x hx).mp (mem_iUnion.mpr ⟨i, hxi⟩), ha⟩
      set p₀ : Ω := ![0, 2 * n + 2, 4 * n + 4]
      have hp₀F : Far (2 * n + 1) p₀ := by simp only [p₀, Far, v0, v1, v2]; omega
      have hp₀C : Cyc p₀ := by simp only [p₀, Cyc, v0, v1, v2]; omega
      obtain ⟨k, hk⟩ := mem_iUnion.mp ((hZ p₀ (far_mono (by omega) hp₀F)).mpr hp₀C)
      apply ih k
      refine ⟨2 * n + 1, Or.inl fun x hx => ⟨fun hxk => ?_, fun hxc => ?_⟩⟩
      · rcases far_cyc_or_acy hx with hc | ha
        · exact hc
        · exact absurd hxk (hA k x (far_mono (by omega) hx) ha)
      · have := const_cyc (box_of_mem (hf k)) (hA k) hx hxc hp₀F hp₀C
        simp only [cnt, hk] at this
        by_contra hn; simp [hn] at this
    · -- anticyclic side
      have hC : ∀ i x, Far n x → Cyc x → x ∉ f i := fun i x hx hc hxi =>
        not_cyc_and_acy x ⟨hc, (hZ x hx).mp (mem_iUnion.mpr ⟨i, hxi⟩)⟩
      set p₀ : Ω := ![0, 4 * n + 4, 2 * n + 2]
      have hp₀F : Far (2 * n + 1) p₀ := by simp only [p₀, Far, v0, v1, v2]; omega
      have hp₀A : Acy p₀ := by simp only [p₀, Acy, v0, v1, v2]; omega
      obtain ⟨k, hk⟩ := mem_iUnion.mp ((hZ p₀ (far_mono (by omega) hp₀F)).mpr hp₀A)
      apply ih k
      refine ⟨2 * n + 1, Or.inr fun x hx => ⟨fun hxk => ?_, fun hxa => ?_⟩⟩
      · rcases far_cyc_or_acy hx with hc | ha
        · exact absurd hxk (hC k x (far_mono (by omega) hx) hc)
        · exact ha
      · have := const_acy (box_of_mem (hf k)) (hC k) hx hxa hp₀F hp₀A
        simp only [cnt, hk] at this
        by_contra hn; simp [hn] at this

/-- The cyclic set with the note's tie convention. -/
def Estar : Set Ω :=
  {x | (if x 0 ≤ x 1 then 1 else 0) + (if x 1 < x 2 then 1 else 0) +
        (if x 2 < x 0 then 1 else 0) = 2}

lemma estar_inF : InF Estar := by
  refine ⟨0, Or.inl fun x hx => ?_⟩
  unfold Far at hx
  simp only [Estar, mem_setOf_eq, Cyc]
  split_ifs <;> omega

/-- **The cyclic set E\* is not in the triangle carrier over ℕ.** -/
theorem estar_not_mem : ¬ D₃.Has Estar := fun h => not_inF_of_mem h estar_inF


/-! ## The homogeneous-set family

A set is caught as soon as it agrees with the cyclic (or anticyclic) set on the
distinct-coordinate points of P³ for SOME infinite P. This is the form reached by any set
with a bad ultrafilter profile (layer 2). The lift lemma runs inside a thinned copy Q ⊆ P in
which a P-element lies strictly between any two Q-elements. -/

def OnP (P : Set ℕ) (x : Ω) : Prop := x 0 ∈ P ∧ x 1 ∈ P ∧ x 2 ∈ P

def Dist (x : Ω) : Prop := x 0 ≠ x 1 ∧ x 1 ≠ x 2 ∧ x 0 ≠ x 2

lemma dist_cyc_or_acy {x : Ω} (h : Dist x) : Cyc x ∨ Acy x := by
  unfold Dist Cyc Acy at *; omega

lemma cyc_dist {x : Ω} (h : Cyc x) : Dist x := by unfold Dist Cyc at *; omega

lemma acy_dist {x : Ω} (h : Acy x) : Dist x := by unfold Dist Acy at *; omega

/-- The homogeneous-set family. -/
def InP (Z : Set Ω) : Prop :=
  ∃ P : Set ℕ, P.Infinite ∧ ((∀ x, OnP P x → Dist x → (x ∈ Z ↔ Cyc x)) ∨
    (∀ x, OnP P x → Dist x → (x ∈ Z ↔ Acy x)))

section LiftP

variable {G : Set Ω} {P Q : Set ℕ} (hB : Box G) (hA : ∀ x, OnP P x → Acy x → x ∉ G)
  (hQP : Q ⊆ P) (hbet : ∀ u ∈ Q, ∀ v ∈ Q, u < v → ∃ w ∈ P, u < w ∧ w < v)
include hB hA hQP hbet

omit hB hQP hbet in
lemma cnt_zeroP {x : Ω} (hx : OnP P x) (ha : Acy x) : cnt G x = 0 := by
  simp [cnt, hA x hx ha]

lemma liftP0 {a b c a' : ℕ} (ha : a ∈ Q) (hb : b ∈ Q) (hc : c ∈ Q) (ha' : a' ∈ Q)
    (hab : a < b) (hbc : b < c) (hca : c < a') : cnt G ![a, b, c] = cnt G ![a', b, c] := by
  obtain ⟨γ, hγ, h1, h2⟩ := hbet a ha b hb hab
  obtain ⟨β, hβ, h3, h4⟩ := hbet c hc a' ha' hca
  have pa := hQP ha; have pb := hQP hb; have pc := hQP hc; have pa' := hQP ha'
  have h := hB a a' b β c γ
  have z1 : cnt G ![a', β, c] = 0 :=
    cnt_zeroP hA ⟨pa', hβ, pc⟩ (by simp only [Acy, v0, v1, v2]; omega)
  have z2 : cnt G ![a', b, γ] = 0 :=
    cnt_zeroP hA ⟨pa', pb, hγ⟩ (by simp only [Acy, v0, v1, v2]; omega)
  have z3 : cnt G ![a, β, γ] = 0 :=
    cnt_zeroP hA ⟨pa, hβ, hγ⟩ (by simp only [Acy, v0, v1, v2]; omega)
  have z4 : cnt G ![a, β, c] = 0 :=
    cnt_zeroP hA ⟨pa, hβ, pc⟩ (by simp only [Acy, v0, v1, v2]; omega)
  have z5 : cnt G ![a, b, γ] = 0 :=
    cnt_zeroP hA ⟨pa, pb, hγ⟩ (by simp only [Acy, v0, v1, v2]; omega)
  have z6 : cnt G ![a', β, γ] = 0 :=
    cnt_zeroP hA ⟨pa', hβ, hγ⟩ (by simp only [Acy, v0, v1, v2]; omega)
  omega

lemma liftP1 {a b c a' : ℕ} (ha : a ∈ Q) (hb : b ∈ Q) (hc : c ∈ Q) (ha' : a' ∈ Q)
    (hab : a < b) (hbc : b < c) (hca : c < a') : cnt G ![c, a, b] = cnt G ![c, a', b] := by
  obtain ⟨γ, hγ, h1, h2⟩ := hbet a ha b hb hab
  obtain ⟨β, hβ, h3, h4⟩ := hbet c hc a' ha' hca
  have pa := hQP ha; have pb := hQP hb; have pc := hQP hc; have pa' := hQP ha'
  have h := hB c γ a a' b β
  have z1 : cnt G ![γ, a', b] = 0 :=
    cnt_zeroP hA ⟨hγ, pa', pb⟩ (by simp only [Acy, v0, v1, v2]; omega)
  have z2 : cnt G ![γ, a, β] = 0 :=
    cnt_zeroP hA ⟨hγ, pa, hβ⟩ (by simp only [Acy, v0, v1, v2]; omega)
  have z3 : cnt G ![c, a', β] = 0 :=
    cnt_zeroP hA ⟨pc, pa', hβ⟩ (by simp only [Acy, v0, v1, v2]; omega)
  have z4 : cnt G ![γ, a, b] = 0 :=
    cnt_zeroP hA ⟨hγ, pa, pb⟩ (by simp only [Acy, v0, v1, v2]; omega)
  have z5 : cnt G ![c, a, β] = 0 :=
    cnt_zeroP hA ⟨pc, pa, hβ⟩ (by simp only [Acy, v0, v1, v2]; omega)
  have z6 : cnt G ![γ, a', β] = 0 :=
    cnt_zeroP hA ⟨hγ, pa', hβ⟩ (by simp only [Acy, v0, v1, v2]; omega)
  omega

lemma liftP2 {a b c a' : ℕ} (ha : a ∈ Q) (hb : b ∈ Q) (hc : c ∈ Q) (ha' : a' ∈ Q)
    (hab : a < b) (hbc : b < c) (hca : c < a') : cnt G ![b, c, a] = cnt G ![b, c, a'] := by
  obtain ⟨γ, hγ, h1, h2⟩ := hbet a ha b hb hab
  obtain ⟨β, hβ, h3, h4⟩ := hbet c hc a' ha' hca
  have pa := hQP ha; have pb := hQP hb; have pc := hQP hc; have pa' := hQP ha'
  have h := hB b β c γ a a'
  have z1 : cnt G ![β, γ, a] = 0 :=
    cnt_zeroP hA ⟨hβ, hγ, pa⟩ (by simp only [Acy, v0, v1, v2]; omega)
  have z2 : cnt G ![β, c, a'] = 0 :=
    cnt_zeroP hA ⟨hβ, pc, pa'⟩ (by simp only [Acy, v0, v1, v2]; omega)
  have z3 : cnt G ![b, γ, a'] = 0 :=
    cnt_zeroP hA ⟨pb, hγ, pa'⟩ (by simp only [Acy, v0, v1, v2]; omega)
  have z4 : cnt G ![β, c, a] = 0 :=
    cnt_zeroP hA ⟨hβ, pc, pa⟩ (by simp only [Acy, v0, v1, v2]; omega)
  have z5 : cnt G ![b, γ, a] = 0 :=
    cnt_zeroP hA ⟨pb, hγ, pa⟩ (by simp only [Acy, v0, v1, v2]; omega)
  have z6 : cnt G ![β, γ, a'] = 0 :=
    cnt_zeroP hA ⟨hβ, hγ, pa'⟩ (by simp only [Acy, v0, v1, v2]; omega)
  omega

lemma reachP012 {a b c L₁ L₂ L₃ : ℕ} (ha : a ∈ Q) (hb : b ∈ Q) (hc : c ∈ Q)
    (h₁ : L₁ ∈ Q) (h₂ : L₂ ∈ Q) (h₃ : L₃ ∈ Q) (hab : a < b) (hbc : b < c)
    (hc₁ : c < L₁) (h₁₂ : L₁ < L₂) (h₂₃ : L₂ < L₃) :
    cnt G ![a, b, c] = cnt G ![L₁, L₂, L₃] := by
  rw [liftP0 hB hA hQP hbet ha hb hc h₁ hab hbc hc₁,
    liftP1 hB hA hQP hbet hb hc h₁ h₂ hbc hc₁ h₁₂,
    liftP2 hB hA hQP hbet hc h₁ h₂ h₃ hc₁ h₁₂ h₂₃]

lemma reachP (hunb : ∀ m, ∃ v ∈ Q, m < v) {p : Ω} (hp : OnP Q p) (hC : Cyc p) :
    ∃ m, ∀ L₁ L₂ L₃, L₁ ∈ Q → L₂ ∈ Q → L₃ ∈ Q → m < L₁ → L₁ < L₂ → L₂ < L₃ →
      cnt G p = cnt G ![L₁, L₂, L₃] := by
  obtain ⟨h0, h1, h2⟩ := hp
  rw [eta p]
  unfold Cyc at hC
  rcases hC with ⟨c1, c2⟩ | ⟨c1, c2⟩ | ⟨c1, c2⟩
  · exact ⟨p 2, fun L₁ L₂ L₃ m₁ m₂ m₃ k₁ k₂ k₃ =>
      reachP012 hB hA hQP hbet h0 h1 h2 m₁ m₂ m₃ c1 c2 k₁ k₂ k₃⟩
  · -- 120-point: lift x₁, then x₂, to reach a 012-point
    obtain ⟨a', ha', ha'lt⟩ := hunb (p 0)
    obtain ⟨b', hb', hb'lt⟩ := hunb a'
    refine ⟨b', fun L₁ L₂ L₃ m₁ m₂ m₃ k₁ k₂ k₃ => ?_⟩
    rw [liftP1 hB hA hQP hbet h1 h2 h0 ha' c1 c2 ha'lt,
      liftP2 hB hA hQP hbet h2 h0 ha' hb' c2 ha'lt hb'lt]
    exact reachP012 hB hA hQP hbet h0 ha' hb' m₁ m₂ m₃ ha'lt hb'lt k₁ k₂ k₃
  · -- 201-point: lift x₂ to reach a 012-point
    obtain ⟨a', ha', ha'lt⟩ := hunb (p 1)
    refine ⟨a', fun L₁ L₂ L₃ m₁ m₂ m₃ k₁ k₂ k₃ => ?_⟩
    rw [liftP2 hB hA hQP hbet h2 h0 h1 ha' c1 c2 ha'lt]
    exact reachP012 hB hA hQP hbet h0 h1 ha' m₁ m₂ m₃ c2 ha'lt k₁ k₂ k₃

/-- **Constancy on the cyclic points of Q³.** -/
theorem constP_cyc (hunb : ∀ m, ∃ v ∈ Q, m < v) {p q : Ω} (hp : OnP Q p) (hpc : Cyc p)
    (hq : OnP Q q) (hqc : Cyc q) : cnt G p = cnt G q := by
  obtain ⟨m₁, e₁⟩ := reachP hB hA hQP hbet hunb hp hpc
  obtain ⟨m₂, e₂⟩ := reachP hB hA hQP hbet hunb hq hqc
  obtain ⟨L₁, l₁, k₁⟩ := hunb (m₁ + m₂)
  obtain ⟨L₂, l₂, k₂⟩ := hunb L₁
  obtain ⟨L₃, l₃, k₃⟩ := hunb L₂
  rw [e₁ L₁ L₂ L₃ l₁ l₂ l₃ (by omega) k₂ k₃, e₂ L₁ L₂ L₃ l₁ l₂ l₃ (by omega) k₂ k₃]

end LiftP

theorem constP_acy {G : Set Ω} {P Q : Set ℕ} (hB : Box G)
    (hC : ∀ x, OnP P x → Cyc x → x ∉ G) (hQP : Q ⊆ P)
    (hbet : ∀ u ∈ Q, ∀ v ∈ Q, u < v → ∃ w ∈ P, u < w ∧ w < v)
    (hunb : ∀ m, ∃ v ∈ Q, m < v) {p q : Ω} (hp : OnP Q p) (hpa : Acy p)
    (hq : OnP Q q) (hqa : Acy q) : cnt G p = cnt G q := by
  have hA' : ∀ x, OnP P x → Acy x → x ∉ {x | ρ x ∈ G} := by
    intro x hx ha
    exact hC (ρ x) ⟨hx.1, hx.2.2, hx.2.1⟩
      (by unfold Acy at ha; unfold Cyc ρ; simp only [v0, v1, v2]; omega)
  have key := constP_cyc (box_refl hB) hA' hQP hbet hunb (p := ρ p) (q := ρ q)
    ⟨hp.1, hp.2.2, hp.2.1⟩
    (by unfold Acy at hpa; unfold Cyc ρ; simp only [v0, v1, v2]; omega)
    ⟨hq.1, hq.2.2, hq.2.1⟩
    (by unfold Acy at hqa; unfold Cyc ρ; simp only [v0, v1, v2]; omega)
  rwa [cnt_pre, cnt_pre, ρρ, ρρ] at key

/-- Thinning: every infinite P contains an unbounded Q with a P-element between any two
Q-elements (Q = the even-indexed elements of P). -/
lemma thin (P : Set ℕ) (hP : P.Infinite) : ∃ Q ⊆ P, (∀ m, ∃ v ∈ Q, m < v) ∧
    (∀ u ∈ Q, ∀ v ∈ Q, u < v → ∃ w ∈ P, u < w ∧ w < v) := by
  have hf : (setOf (· ∈ P)).Infinite := hP
  have hmono := Nat.nth_strictMono hf
  refine ⟨Set.range (fun k => Nat.nth (· ∈ P) (2 * k)), ?_, ?_, ?_⟩
  · rintro _ ⟨k, rfl⟩; exact Nat.nth_mem_of_infinite hf _
  · intro m
    refine ⟨_, ⟨m + 1, rfl⟩, ?_⟩
    have := hmono.id_le (2 * (m + 1)); simp only [id] at this ⊢; omega
  · rintro _ ⟨i, rfl⟩ _ ⟨j, rfl⟩ hij
    have hij' : 2 * i < 2 * j := hmono.lt_iff_lt.mp hij
    exact ⟨Nat.nth (· ∈ P) (2 * i + 1), Nat.nth_mem_of_infinite hf _,
      hmono (by omega), hmono (by omega)⟩

lemma infinite_of_unb {Q : Set ℕ} (hunb : ∀ m, ∃ v ∈ Q, m < v) : Q.Infinite := by
  refine Set.infinite_of_not_bddAbove ?_
  rintro ⟨m, hm⟩
  obtain ⟨v, hv, hlt⟩ := hunb m
  exact absurd (hm hv) (not_le.mpr hlt)

/-- Four increasing elements of an infinite set. -/
lemma four (P : Set ℕ) (hP : P.Infinite) :
    ∃ e₀ e₁ e₂ e₃, e₀ ∈ P ∧ e₁ ∈ P ∧ e₂ ∈ P ∧ e₃ ∈ P ∧ e₀ < e₁ ∧ e₁ < e₂ ∧ e₂ < e₃ := by
  have hf : (setOf (· ∈ P)).Infinite := hP
  have hmono := Nat.nth_strictMono hf
  exact ⟨_, _, _, _, Nat.nth_mem_of_infinite hf 0, Nat.nth_mem_of_infinite hf 1,
    Nat.nth_mem_of_infinite hf 2, Nat.nth_mem_of_infinite hf 3,
    hmono (by norm_num), hmono (by norm_num), hmono (by norm_num)⟩

lemma not_inP_empty : ¬ InP (∅ : Set Ω) := by
  rintro ⟨P, hP, h | h⟩ <;> obtain ⟨e₀, e₁, e₂, -, h₀, h₁, h₂, -, l₀, l₁, -⟩ := four P hP
  · exact (h ![e₀, e₁, e₂] ⟨h₀, h₁, h₂⟩ (by simp only [Dist, v0, v1, v2]; omega)).mpr
      (by simp only [Cyc, v0, v1, v2]; omega)
  · exact (h ![e₀, e₂, e₁] ⟨h₀, h₂, h₁⟩ (by simp only [Dist, v0, v1, v2]; omega)).mpr
      (by simp only [Acy, v0, v1, v2]; omega)

lemma inP_of_inP_compl {E : Set Ω} (h : InP Eᶜ) : InP E := by
  obtain ⟨P, hP, h | h⟩ := h
  · refine ⟨P, hP, Or.inr fun x hx hd => ?_⟩
    have := h x hx hd; have hca := dist_cyc_or_acy hd; have hn := not_cyc_and_acy x
    simp only [mem_compl_iff] at this
    constructor
    · intro hxE; rcases hca with hc | ha
      · exact absurd hxE (this.mpr hc)
      · exact ha
    · intro ha; by_contra hxE; exact hn ⟨this.mp hxE, ha⟩
  · refine ⟨P, hP, Or.inl fun x hx hd => ?_⟩
    have := h x hx hd; have hca := dist_cyc_or_acy hd; have hn := not_cyc_and_acy x
    simp only [mem_compl_iff] at this
    constructor
    · intro hxE; rcases hca with hc | ha
      · exact hc
      · exact absurd hxE (this.mpr ha)
    · intro hc; by_contra hxE; exact hn ⟨hc, this.mp hxE⟩

lemma not_inP_gens {E : Set Ω} (hE : E ∈ gens) : ¬ InP E := by
  obtain ⟨w, hw, hE⟩ := hE
  rintro ⟨P, hP, h⟩
  obtain ⟨e₀, e₁, e₂, e₃, h₀, h₁, h₂, h₃, l₀, l₁, l₂⟩ := four P hP
  have key : ∀ X Y : Ω, (X ∈ E ↔ Y ∈ E) → OnP P X → OnP P Y → Acy X → Cyc Y → False := by
    intro X Y hXY hX hY hXa hYc
    rcases h with h | h
    · have := (h X hX (acy_dist hXa)).mp (hXY.mpr ((h Y hY (cyc_dist hYc)).mpr hYc))
      exact not_cyc_and_acy X ⟨this, hXa⟩
    · have := (h Y hY (cyc_dist hYc)).mp (hXY.mp ((h X hX (acy_dist hXa)).mpr hXa))
      exact not_cyc_and_acy Y ⟨hYc, this⟩
  have loc : ∀ y z : Ω, (∀ k ∈ w, y k = z k) → (y ∈ E ↔ z ∈ E) :=
    fun y z hyz => window_event_local hE hyz
  rcases hw with rfl | rfl | rfl
  · refine key ![e₀, e₂, e₁] ![e₀, e₂, e₃] (loc _ _ ?_) ⟨h₀, h₂, h₁⟩ ⟨h₀, h₂, h₃⟩ ?_ ?_
    · intro k hk; simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hk
      rcases hk with rfl | rfl <;> rfl
    all_goals simp only [Cyc, Acy, v0, v1, v2]; omega
  · refine key ![e₂, e₁, e₃] ![e₀, e₁, e₃] (loc _ _ ?_) ⟨h₂, h₁, h₃⟩ ⟨h₀, h₁, h₃⟩ ?_ ?_
    · intro k hk; simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hk
      rcases hk with rfl | rfl <;> rfl
    all_goals simp only [Cyc, Acy, v0, v1, v2]; omega
  · refine key ![e₀, e₃, e₂] ![e₀, e₁, e₂] (loc _ _ ?_) ⟨h₀, h₃, h₂⟩ ⟨h₀, h₁, h₂⟩ ?_ ?_
    · intro k hk; simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hk
      rcases hk with rfl | rfl <;> rfl
    all_goals simp only [Cyc, Acy, v0, v1, v2]; omega

/-- **No member of the homogeneous-set family is in the triangle carrier.** -/
theorem not_inP_of_mem {E : Set Ω} (hE : D₃.Has E) : ¬ InP E := by
  induction hE with
  | basic t ht => exact not_inP_gens ht
  | empty => exact not_inP_empty
  | compl _ ih => exact fun h => ih (inP_of_inP_compl h)
  | @iUnion f hd hf ih =>
    rintro ⟨P, hP, hZ | hZ⟩
    · have hA : ∀ i x, OnP P x → Acy x → x ∉ f i := fun i x hx ha hxi =>
        not_cyc_and_acy x ⟨(hZ x hx (acy_dist ha)).mp (mem_iUnion.mpr ⟨i, hxi⟩), ha⟩
      obtain ⟨Q, hQP, hunb, hbet⟩ := thin P hP
      obtain ⟨u₀, hu₀, -⟩ := hunb 0
      obtain ⟨u₁, hu₁, k₁⟩ := hunb u₀
      obtain ⟨u₂, hu₂, k₂⟩ := hunb u₁
      set p₀ : Ω := ![u₀, u₁, u₂]
      have hp₀Q : OnP Q p₀ := ⟨hu₀, hu₁, hu₂⟩
      have hp₀C : Cyc p₀ := by simp only [p₀, Cyc, v0, v1, v2]; omega
      obtain ⟨k, hk⟩ := mem_iUnion.mp ((hZ p₀ ⟨hQP hu₀, hQP hu₁, hQP hu₂⟩
        (cyc_dist hp₀C)).mpr hp₀C)
      apply ih k
      refine ⟨Q, infinite_of_unb hunb, Or.inl fun x hx hd => ⟨fun hxk => ?_, fun hxc => ?_⟩⟩
      · rcases dist_cyc_or_acy hd with hc | ha
        · exact hc
        · exact absurd hxk (hA k x ⟨hQP hx.1, hQP hx.2.1, hQP hx.2.2⟩ ha)
      · have := constP_cyc (box_of_mem (hf k)) (hA k) hQP hbet hunb hx hxc hp₀Q hp₀C
        simp only [cnt, hk] at this
        by_contra hn; simp [hn] at this
    · have hC : ∀ i x, OnP P x → Cyc x → x ∉ f i := fun i x hx hc hxi =>
        not_cyc_and_acy x ⟨hc, (hZ x hx (cyc_dist hc)).mp (mem_iUnion.mpr ⟨i, hxi⟩)⟩
      obtain ⟨Q, hQP, hunb, hbet⟩ := thin P hP
      obtain ⟨u₀, hu₀, -⟩ := hunb 0
      obtain ⟨u₁, hu₁, k₁⟩ := hunb u₀
      obtain ⟨u₂, hu₂, k₂⟩ := hunb u₁
      set p₀ : Ω := ![u₀, u₂, u₁]
      have hp₀Q : OnP Q p₀ := ⟨hu₀, hu₂, hu₁⟩
      have hp₀A : Acy p₀ := by simp only [p₀, Acy, v0, v1, v2]; omega
      obtain ⟨k, hk⟩ := mem_iUnion.mp ((hZ p₀ ⟨hQP hu₀, hQP hu₂, hQP hu₁⟩
        (acy_dist hp₀A)).mpr hp₀A)
      apply ih k
      refine ⟨Q, infinite_of_unb hunb, Or.inr fun x hx hd => ⟨fun hxk => ?_, fun hxa => ?_⟩⟩
      · rcases dist_cyc_or_acy hd with hc | ha
        · exact absurd hxk (hC k x ⟨hQP hx.1, hQP hx.2.1, hQP hx.2.2⟩ hc)
        · exact ha
      · have := constP_acy (box_of_mem (hf k)) (hC k) hQP hbet hunb hx hxa hp₀Q hp₀A
        simp only [cnt, hk] at this
        by_contra hn; simp [hn] at this


/-! ## Layer 2: the staircase state on the triangle

For a non-principal ultrafilter `p` on ℕ, `sstar p = W₀₁₂ + W₁₂₀ − W₁₀₂`, a signed combination of
three iterated-limit ultrafilters on Ω. It is finitely additive on all sets, equals 1 on the
three staircase steps C₀ = {x₀<x₁}, C₁ = {x₁<x₂}, C₂ = {x₂<x₀} (whose intersection is empty),
and is {0,1}-valued on the carrier `D₃`: a set where it takes 2 or −1 has, on an infinite
homogeneous P (ultrafilter Ramsey for triples), the cyclic or anticyclic pattern, so it lies in
the homogeneous-set family, which `not_inP_of_mem` excludes. -/

section Ramsey

/-- Triple iterated `∀ᶠ` along `p`. -/
def E3 (p : Ultrafilter ℕ) (φ : ℕ → ℕ → ℕ → Prop) : Prop :=
  ∀ᶠ u in (p : Filter ℕ), ∀ᶠ v in (p : Filter ℕ), ∀ᶠ w in (p : Filter ℕ), φ u v w

variable {p : Ultrafilter ℕ} (hp : ∀ m, ∀ᶠ n in (p : Filter ℕ), m < n) {T : ℕ → ℕ → ℕ → Prop}

def G1 (p : Ultrafilter ℕ) (T : ℕ → ℕ → ℕ → Prop) (u : ℕ) : Prop :=
  ∀ᶠ v in (p : Filter ℕ), ∀ᶠ w in (p : Filter ℕ), T u v w

def G2 (p : Ultrafilter ℕ) (T : ℕ → ℕ → ℕ → Prop) (u v : ℕ) : Prop :=
  ∀ᶠ w in (p : Filter ℕ), T u v w

def RInv (p : Ultrafilter ℕ) (T : ℕ → ℕ → ℕ → Prop) (F : Finset ℕ) : Prop :=
  (∀ y ∈ F, G1 p T y) ∧ (∀ y ∈ F, ∀ z ∈ F, y < z → G2 p T y z) ∧
    (∀ y ∈ F, ∀ z ∈ F, ∀ t ∈ F, y < z → z < t → T y z t)

def RNext (p : Ultrafilter ℕ) (T : ℕ → ℕ → ℕ → Prop) (n : ℕ) (F : Finset ℕ) (x : ℕ) : Prop :=
  n < x ∧ (∀ y ∈ F, y < x) ∧ G1 p T x ∧ (∀ y ∈ F, G2 p T y x) ∧
    (∀ y ∈ F, ∀ z ∈ F, y < z → T y z x)

include hp in
lemma rnext_eventually (hT : E3 p T) {F : Finset ℕ} (hF : RInv p T F) (n : ℕ) :
    ∀ᶠ x in (p : Filter ℕ), RNext p T n F x := by
  have h1 : ∀ᶠ x in (p : Filter ℕ), ∀ y ∈ F, y < x :=
    (Filter.eventually_all_finset F).2 fun y _ => hp y
  have h2 : ∀ᶠ x in (p : Filter ℕ), ∀ y ∈ F, G2 p T y x :=
    (Filter.eventually_all_finset F).2 fun y hy => hF.1 y hy
  have h3 : ∀ᶠ x in (p : Filter ℕ), ∀ y ∈ F, ∀ z ∈ F, y < z → T y z x :=
    (Filter.eventually_all_finset F).2 fun y hy => (Filter.eventually_all_finset F).2
      fun z hz => by
        by_cases hyz : y < z
        · exact (hF.2.1 y hy z hz hyz).mono fun x hx _ => hx
        · exact Filter.Eventually.of_forall fun x h => absurd h hyz
  have hT' : ∀ᶠ x in (p : Filter ℕ), G1 p T x := hT
  filter_upwards [hp n, h1, hT', h2, h3] with x a b c d e
  exact ⟨a, b, c, d, e⟩

lemma rinv_insert {F : Finset ℕ} {n x : ℕ} (hF : RInv p T F) (hx : RNext p T n F x) :
    RInv p T (insert x F) := by
  obtain ⟨-, hlt, hG1, hG2, hT⟩ := hx
  refine ⟨fun y hy => ?_, fun y hy z hz hyz => ?_, fun y hy z hz t ht hyz hzt => ?_⟩
  · rcases Finset.mem_insert.mp hy with rfl | hy
    · exact hG1
    · exact hF.1 y hy
  · rcases Finset.mem_insert.mp hy with hyx | hy' <;>
      rcases Finset.mem_insert.mp hz with hzx | hz'
    · omega
    · have := hlt z hz'; omega
    · subst hzx; exact hG2 y hy'
    · exact hF.2.1 y hy' z hz' hyz
  · rcases Finset.mem_insert.mp hy with hyx | hy' <;>
      rcases Finset.mem_insert.mp hz with hzx | hz' <;>
      rcases Finset.mem_insert.mp ht with htx | ht'
    · omega
    · omega
    · omega
    · have := hlt z hz'; omega
    · omega
    · have := hlt t ht'; omega
    · subst htx; exact hT y hy' z hz' hyz
    · exact hF.2.2 y hy' z hz' t ht' hyz hzt

/-- The greedy sequence of finite sets. -/
noncomputable def rseq (p : Ultrafilter ℕ) (T : ℕ → ℕ → ℕ → Prop) : ℕ → Finset ℕ
  | 0 => ∅
  | n + 1 => insert (Classical.epsilon (RNext p T n (rseq p T n))) (rseq p T n)

include hp in
lemma rseq_spec (hT : E3 p T) (n : ℕ) :
    RInv p T (rseq p T n) ∧ RNext p T n (rseq p T n) (Classical.epsilon (RNext p T n (rseq p T n))) := by
  induction n with
  | zero =>
    have h0 : RInv p T (rseq p T 0) := by simp [RInv, rseq]
    exact ⟨h0, Classical.epsilon_spec (rnext_eventually hp hT h0 0).exists⟩
  | succ n ih =>
    have h1 : RInv p T (rseq p T (n + 1)) := rinv_insert ih.1 ih.2
    exact ⟨h1, Classical.epsilon_spec (rnext_eventually hp hT h1 (n + 1)).exists⟩

lemma rseq_mono : Monotone (rseq p T) :=
  monotone_nat_of_le_succ fun n => Finset.subset_insert _ _

include hp in
/-- **Ultrafilter Ramsey for triples.** -/
theorem ramsey3 (hT : E3 p T) :
    ∃ P : Set ℕ, P.Infinite ∧ ∀ u ∈ P, ∀ v ∈ P, ∀ w ∈ P, u < v → v < w → T u v w := by
  refine ⟨{x | ∃ n, x ∈ rseq p T n}, infinite_of_unb fun m => ?_, ?_⟩
  · refine ⟨Classical.epsilon (RNext p T m (rseq p T m)), ⟨m + 1, Finset.mem_insert_self _ _⟩,
      (rseq_spec hp hT m).2.1⟩
  · rintro u ⟨i, hi⟩ v ⟨j, hj⟩ w ⟨k, hk⟩ huv hvw
    have hs := (rseq_spec hp hT (i + j + k)).1
    exact hs.2.2 u (rseq_mono (by omega) hi) v (rseq_mono (by omega) hj) w
      (rseq_mono (by omega) hk) huv hvw

end Ramsey

section State

variable (p : Ultrafilter ℕ)

/-- The six placements of a sorted triple u<v<w (named by the coordinate order from smallest). -/
def o012 (u v w : ℕ) : Ω := ![u, v, w]
def o120 (u v w : ℕ) : Ω := ![w, u, v]
def o201 (u v w : ℕ) : Ω := ![v, w, u]
def o021 (u v w : ℕ) : Ω := ![u, w, v]
def o210 (u v w : ℕ) : Ω := ![w, v, u]
def o102 (u v w : ℕ) : Ω := ![v, u, w]

def Ev3 (o : ℕ → ℕ → ℕ → Ω) (E : Set Ω) : Prop := E3 p fun u v w => o u v w ∈ E

/-- The iterated-limit ultrafilter along placement `o`, as a {0,1} value. -/
noncomputable def Wv (o : ℕ → ℕ → ℕ → Ω) (E : Set Ω) : ℤ := by
  classical exact if Ev3 p o E then 1 else 0

/-- **The staircase functional.** -/
noncomputable def sstar (E : Set Ω) : ℤ := Wv p o012 E + Wv p o120 E - Wv p o102 E

lemma ev3_compl (o : ℕ → ℕ → ℕ → Ω) (E : Set Ω) : Ev3 p o Eᶜ ↔ ¬ Ev3 p o E := by
  simp only [Ev3, E3, Set.mem_compl_iff, Ultrafilter.eventually_not]

lemma ev3_union (o : ℕ → ℕ → ℕ → Ω) (A B : Set Ω) :
    Ev3 p o (A ∪ B) ↔ Ev3 p o A ∨ Ev3 p o B := by
  simp only [Ev3, E3, Set.mem_union, Ultrafilter.eventually_or]

lemma ev3_mono {o : ℕ → ℕ → ℕ → Ω} {A B : Set Ω} (h : A ⊆ B) (hA : Ev3 p o A) : Ev3 p o B :=
  hA.mono fun _ hu => hu.mono fun _ hv => hv.mono fun _ hw => h hw

lemma wv_cases (o : ℕ → ℕ → ℕ → Ω) (E : Set Ω) : Wv p o E = 0 ∨ Wv p o E = 1 := by
  unfold Wv; split_ifs <;> simp

lemma wv_one {o : ℕ → ℕ → ℕ → Ω} {E : Set Ω} : Wv p o E = 1 ↔ Ev3 p o E := by
  unfold Wv; split_ifs with h <;> simp [h]

lemma wv_union {o : ℕ → ℕ → ℕ → Ω} {A B : Set Ω} (hd : Disjoint A B) :
    Wv p o (A ∪ B) = Wv p o A + Wv p o B := by
  have hAB : Ev3 p o A → ¬ Ev3 p o B := fun hA =>
    (ev3_compl p o B).mp (ev3_mono p (fun x hx => Set.disjoint_left.mp hd hx) hA)
  unfold Wv
  by_cases ha : Ev3 p o A <;> by_cases hb : Ev3 p o B
  · exact absurd hb (hAB ha)
  all_goals simp [ev3_union, ha, hb]

theorem sstar_union {A B : Set Ω} (hd : Disjoint A B) :
    sstar p (A ∪ B) = sstar p A + sstar p B := by
  simp only [sstar, wv_union p hd]; ring

theorem sstar_univ : sstar p univ = 1 := by
  have h : ∀ o, Wv p o univ = 1 := fun o => (wv_one p).mpr
    (Filter.Eventually.of_forall fun _ => Filter.Eventually.of_forall fun _ =>
      Filter.Eventually.of_forall fun _ => mem_univ _)
  simp [sstar, h]

variable {p} (hp : ∀ m, ∀ᶠ n in (p : Filter ℕ), m < n)
include hp

lemma e3_order {φ : ℕ → ℕ → ℕ → Prop} (h : ∀ u v w, u < v → v < w → φ u v w) : E3 p φ :=
  Filter.Eventually.of_forall fun u => (hp u).mono fun v huv => (hp v).mono fun w hvw =>
    h u v w huv hvw

lemma wv_of_order {o : ℕ → ℕ → ℕ → Ω} {E : Set Ω} (h : ∀ u v w, u < v → v < w → o u v w ∈ E) :
    Wv p o E = 1 := (wv_one p).mpr (e3_order hp h)

lemma wv_of_order' {o : ℕ → ℕ → ℕ → Ω} {E : Set Ω} (h : ∀ u v w, u < v → v < w → o u v w ∉ E) :
    Wv p o E = 0 := by
  have : ¬ Ev3 p o E := (ev3_compl p o E).mp (e3_order hp fun u v w h1 h2 => h u v w h1 h2)
  unfold Wv; simp [this]

/-- The staircase steps. -/
def C₀ : Set Ω := {x | x 0 < x 1}
def C₁ : Set Ω := {x | x 1 < x 2}
def C₂ : Set Ω := {x | x 2 < x 0}

theorem sstar_C₀ : sstar p C₀ = 1 := by
  rw [sstar, wv_of_order hp (fun u v w h1 h2 => by simp [o012, C₀]; omega),
    wv_of_order' hp (fun u v w h1 h2 => by simp [o120, C₀]; omega),
    wv_of_order' hp (fun u v w h1 h2 => by simp [o102, C₀]; omega)]; norm_num

theorem sstar_C₁ : sstar p C₁ = 1 := by
  rw [sstar, wv_of_order hp (fun u v w h1 h2 => by simp [o012, C₁]; omega),
    wv_of_order hp (fun u v w h1 h2 => by simp [o120, C₁]; omega),
    wv_of_order hp (fun u v w h1 h2 => by simp [o102, C₁]; omega)]; norm_num

theorem sstar_C₂ : sstar p C₂ = 1 := by
  rw [sstar, wv_of_order' hp (fun u v w h1 h2 => by simp [o012, C₂]; omega),
    wv_of_order hp (fun u v w h1 h2 => by simp [o120, C₂]; omega),
    wv_of_order' hp (fun u v w h1 h2 => by simp [o102, C₂]; omega)]; norm_num

omit hp in
lemma e3_and {φ ψ : ℕ → ℕ → ℕ → Prop} (h1 : E3 p φ) (h2 : E3 p ψ) :
    E3 p fun u v w => φ u v w ∧ ψ u v w :=
  (h1.and h2).mono fun _ ⟨a, b⟩ => (a.and b).mono fun _ ⟨c, d⟩ => (c.and d).mono
    fun _ ⟨e, f⟩ => ⟨e, f⟩

omit hp in
lemma e3_iff (o : ℕ → ℕ → ℕ → Ω) (E : Set Ω) : E3 p fun u v w => (o u v w ∈ E ↔ Ev3 p o E) := by
  by_cases h : Ev3 p o E
  · exact h.mono fun _ hu => hu.mono fun _ hv => hv.mono fun _ hw => ⟨fun _ => h, fun _ => hw⟩
  · exact ((ev3_compl p o E).mpr h).mono fun _ hu => hu.mono fun _ hv => hv.mono
      fun _ hw => ⟨fun h2 => absurd h2 hw, fun h2 => absurd h2 h⟩

/-- An infinite set on which membership in `E` follows the six-order profile. -/
lemma homog (E : Set Ω) : ∃ P : Set ℕ, P.Infinite ∧ ∀ u ∈ P, ∀ v ∈ P, ∀ w ∈ P, u < v → v < w →
    (o012 u v w ∈ E ↔ Ev3 p o012 E) ∧ (o120 u v w ∈ E ↔ Ev3 p o120 E) ∧
    (o201 u v w ∈ E ↔ Ev3 p o201 E) ∧ (o021 u v w ∈ E ↔ Ev3 p o021 E) ∧
    (o210 u v w ∈ E ↔ Ev3 p o210 E) ∧ (o102 u v w ∈ E ↔ Ev3 p o102 E) :=
  ramsey3 hp (e3_and (e3_iff o012 E) (e3_and (e3_iff o120 E) (e3_and (e3_iff o201 E)
    (e3_and (e3_iff o021 E) (e3_and (e3_iff o210 E) (e3_iff o102 E))))))

omit hp in
lemma six (P : Set ℕ) (hP : P.Infinite) : ∃ e₀ e₁ e₂ e₃ e₄ e₅, e₀ ∈ P ∧ e₁ ∈ P ∧ e₂ ∈ P ∧
    e₃ ∈ P ∧ e₄ ∈ P ∧ e₅ ∈ P ∧ e₀ < e₁ ∧ e₁ < e₂ ∧ e₂ < e₃ ∧ e₃ < e₄ ∧ e₄ < e₅ := by
  have hf : (setOf (· ∈ P)).Infinite := hP
  have hmono := Nat.nth_strictMono hf
  exact ⟨_, _, _, _, _, _, Nat.nth_mem_of_infinite hf 0, Nat.nth_mem_of_infinite hf 1,
    Nat.nth_mem_of_infinite hf 2, Nat.nth_mem_of_infinite hf 3, Nat.nth_mem_of_infinite hf 4,
    Nat.nth_mem_of_infinite hf 5, hmono (by norm_num), hmono (by norm_num),
    hmono (by norm_num), hmono (by norm_num), hmono (by norm_num)⟩

omit hp in
lemma cnt_wv {E : Set Ω} {x : Ω} {o : ℕ → ℕ → ℕ → Ω} (h : x ∈ E ↔ Ev3 p o E) :
    (cnt E x : ℤ) = Wv p o E := by
  unfold cnt Wv
  by_cases hx : x ∈ E
  · simp [hx, h.mp hx]
  · simp [hx, (not_congr h).mp hx]

omit hp in
/-- The two box identities cut the six order bits to the span; on it, s* ∈ {2, −1} forces the
cyclic or the anticyclic pattern. -/
lemma pat_arith (A B C D F G : ℤ) (hA : A = 0 ∨ A = 1) (hB : B = 0 ∨ B = 1) (hC : C = 0 ∨ C = 1)
    (hD : D = 0 ∨ D = 1) (hF : F = 0 ∨ F = 1) (hG : G = 0 ∨ G = 1)
    (h1 : A + C + G + A = B + D + A + A) (h2 : D + C + G + A = F + D + A + A)
    (hne : ¬(A + B - G = 0 ∨ A + B - G = 1)) :
    (A = 1 ∧ B = 1 ∧ C = 1 ∧ D = 0 ∧ F = 0 ∧ G = 0) ∨
      (A = 0 ∧ B = 0 ∧ C = 0 ∧ D = 1 ∧ F = 1 ∧ G = 1) := by
  omega

/-- **The staircase functional is {0,1}-valued on the triangle carrier.** -/
theorem sstar_mem {E : Set Ω} (hE : D₃.Has E) : sstar p E = 0 ∨ sstar p E = 1 := by
  by_contra hne
  obtain ⟨P, hP, hH⟩ := homog hp E
  obtain ⟨e₀, e₁, e₂, e₃, e₄, e₅, m₀, m₁, m₂, m₃, m₄, m₅, l₀, l₁, l₂, l₃, l₄⟩ := six P hP
  have hB := box_of_mem hE
  have b1 := hB e₀ e₃ e₁ e₄ e₂ e₅
  have b2 := hB e₀ e₃ e₂ e₄ e₁ e₅
  -- corners of the first box
  have c1 := cnt_wv (x := ![e₀, e₁, e₂]) (hH e₀ m₀ e₁ m₁ e₂ m₂ l₀ l₁).1
  have c2 := cnt_wv (x := ![e₃, e₄, e₂]) (hH e₂ m₂ e₃ m₃ e₄ m₄ l₂ l₃).2.2.1
  have c3 := cnt_wv (x := ![e₃, e₁, e₅]) (hH e₁ m₁ e₃ m₃ e₅ m₅ (by omega) (by omega)).2.2.2.2.2
  have c4 := cnt_wv (x := ![e₀, e₄, e₅]) (hH e₀ m₀ e₄ m₄ e₅ m₅ (by omega) l₄).1
  have c5 := cnt_wv (x := ![e₃, e₁, e₂]) (hH e₁ m₁ e₂ m₂ e₃ m₃ l₁ l₂).2.1
  have c6 := cnt_wv (x := ![e₀, e₄, e₂]) (hH e₀ m₀ e₂ m₂ e₄ m₄ (by omega) (by omega)).2.2.2.1
  have c7 := cnt_wv (x := ![e₀, e₁, e₅]) (hH e₀ m₀ e₁ m₁ e₅ m₅ l₀ (by omega)).1
  have c8 := cnt_wv (x := ![e₃, e₄, e₅]) (hH e₃ m₃ e₄ m₄ e₅ m₅ l₃ l₄).1
  -- corners of the second box
  have d1 := cnt_wv (x := ![e₀, e₂, e₁]) (hH e₀ m₀ e₁ m₁ e₂ m₂ l₀ l₁).2.2.2.1
  have d2 := cnt_wv (x := ![e₃, e₄, e₁]) (hH e₁ m₁ e₃ m₃ e₄ m₄ (by omega) l₃).2.2.1
  have d3 := cnt_wv (x := ![e₃, e₂, e₅]) (hH e₂ m₂ e₃ m₃ e₅ m₅ l₂ (by omega)).2.2.2.2.2
  have d5 := cnt_wv (x := ![e₃, e₂, e₁]) (hH e₁ m₁ e₂ m₂ e₃ m₃ l₁ l₂).2.2.2.2.1
  have d6 := cnt_wv (x := ![e₀, e₄, e₁]) (hH e₀ m₀ e₁ m₁ e₄ m₄ l₀ (by omega)).2.2.2.1
  have d7 := cnt_wv (x := ![e₀, e₂, e₅]) (hH e₀ m₀ e₂ m₂ e₅ m₅ (by omega) (by omega)).1
  have b1' : ((cnt E ![e₀, e₁, e₂] : ℕ) : ℤ) + cnt E ![e₃, e₄, e₂] + cnt E ![e₃, e₁, e₅] +
      cnt E ![e₀, e₄, e₅] = cnt E ![e₃, e₁, e₂] + cnt E ![e₀, e₄, e₂] + cnt E ![e₀, e₁, e₅] +
      cnt E ![e₃, e₄, e₅] := by exact_mod_cast b1
  have b2' : ((cnt E ![e₀, e₂, e₁] : ℕ) : ℤ) + cnt E ![e₃, e₄, e₁] + cnt E ![e₃, e₂, e₅] +
      cnt E ![e₀, e₄, e₅] = cnt E ![e₃, e₂, e₁] + cnt E ![e₀, e₄, e₁] + cnt E ![e₀, e₂, e₅] +
      cnt E ![e₃, e₄, e₅] := by exact_mod_cast b2
  rw [c1, c2, c3, c4, c5, c6, c7, c8] at b1'
  rw [d1, d2, d3, c4, d5, d6, d7, c8] at b2'
  have w1 := wv_cases p o012 E; have w2 := wv_cases p o120 E; have w3 := wv_cases p o201 E
  have w4 := wv_cases p o021 E; have w5 := wv_cases p o210 E; have w6 := wv_cases p o102 E
  simp only [sstar] at hne
  have hpat := pat_arith (Wv p o012 E) (Wv p o120 E) (Wv p o201 E) (Wv p o021 E) (Wv p o210 E)
    (Wv p o102 E) w1 w2 w3 w4 w5 w6 b1' b2' hne
  apply not_inP_of_mem hE
  have z : ∀ {o : ℕ → ℕ → ℕ → Ω}, Wv p o E = 0 → ¬ Ev3 p o E := fun h h' => by
    rw [(wv_one p).mpr h'] at h; exact one_ne_zero h
  refine ⟨P, hP, ?_⟩
  rcases hpat with ⟨q1, q2, q3, q4, q5, q6⟩ | ⟨q1, q2, q3, q4, q5, q6⟩
  · refine Or.inl fun x hx hd => ?_
    obtain ⟨a, b, c, rfl⟩ : ∃ a b c, x = ![a, b, c] := ⟨_, _, _, eta x⟩
    obtain ⟨ha, hb, hc⟩ := hx
    simp only [Dist, v0, v1, v2] at hd ha hb hc
    simp only [Cyc, v0, v1, v2]
    rcases (show (a < b ∧ b < c) ∨ (b < c ∧ c < a) ∨ (c < a ∧ a < b) ∨ (a < c ∧ c < b) ∨
        (c < b ∧ b < a) ∨ (b < a ∧ a < c) by omega) with h | h | h | h | h | h
    · have e := (hH a ha b hb c hc h.1 h.2).1
      exact e.trans ⟨fun _ => Or.inl h, fun _ => (wv_one p).mp q1⟩
    · have e := (hH b hb c hc a ha h.1 h.2).2.1
      exact e.trans ⟨fun _ => Or.inr (Or.inl h), fun _ => (wv_one p).mp q2⟩
    · have e := (hH c hc a ha b hb h.1 h.2).2.2.1
      exact e.trans ⟨fun _ => Or.inr (Or.inr h), fun _ => (wv_one p).mp q3⟩
    · have e := (hH a ha c hc b hb h.1 h.2).2.2.2.1
      exact e.trans ⟨fun h' => absurd h' (z q4), fun h' => by omega⟩
    · have e := (hH c hc b hb a ha h.1 h.2).2.2.2.2.1
      exact e.trans ⟨fun h' => absurd h' (z q5), fun h' => by omega⟩
    · have e := (hH b hb a ha c hc h.1 h.2).2.2.2.2.2
      exact e.trans ⟨fun h' => absurd h' (z q6), fun h' => by omega⟩
  · refine Or.inr fun x hx hd => ?_
    obtain ⟨a, b, c, rfl⟩ : ∃ a b c, x = ![a, b, c] := ⟨_, _, _, eta x⟩
    obtain ⟨ha, hb, hc⟩ := hx
    simp only [Dist, v0, v1, v2] at hd ha hb hc
    simp only [Acy, v0, v1, v2]
    rcases (show (a < b ∧ b < c) ∨ (b < c ∧ c < a) ∨ (c < a ∧ a < b) ∨ (a < c ∧ c < b) ∨
        (c < b ∧ b < a) ∨ (b < a ∧ a < c) by omega) with h | h | h | h | h | h
    · have e := (hH a ha b hb c hc h.1 h.2).1
      exact e.trans ⟨fun h' => absurd h' (z q1), fun h' => by omega⟩
    · have e := (hH b hb c hc a ha h.1 h.2).2.1
      exact e.trans ⟨fun h' => absurd h' (z q2), fun h' => by omega⟩
    · have e := (hH c hc a ha b hb h.1 h.2).2.2.1
      exact e.trans ⟨fun h' => absurd h' (z q3), fun h' => by omega⟩
    · have e := (hH a ha c hc b hb h.1 h.2).2.2.2.1
      exact e.trans ⟨fun _ => Or.inl h, fun _ => (wv_one p).mp q4⟩
    · have e := (hH c hc b hb a ha h.1 h.2).2.2.2.2.1
      exact e.trans ⟨fun _ => Or.inr (Or.inl h), fun _ => (wv_one p).mp q5⟩
    · have e := (hH b hb a ha c hc h.1 h.2).2.2.2.2.2
      exact e.trans ⟨fun _ => Or.inr (Or.inr h), fun _ => (wv_one p).mp q6⟩


/-! ## Layer 3: every tensor-type twist on the triangle

Placements with ties (ordered partitions of {0,1,2} with a repeated value), homogeneity for all
13 placements, and the strict-pattern step shared by every family. Each family's proof uses a
minimal set of box identities found by brute force
(`formalization/tools/gen_triangle_family.py` generates it). -/

def t01_2 (u v _w : ℕ) : Ω := ![u, u, v]
def t2_01 (u v _w : ℕ) : Ω := ![v, v, u]
def t0_12 (u v _w : ℕ) : Ω := ![u, v, v]
def t12_0 (u v _w : ℕ) : Ω := ![v, u, u]
def t02_1 (u v _w : ℕ) : Ω := ![u, v, u]
def t1_02 (u v _w : ℕ) : Ω := ![v, u, v]
def t012 (u _v _w : ℕ) : Ω := ![u, u, u]

omit hp in
/-- Membership along placement `o` follows its limit, on increasing triples from `P`. -/
def HomogAt (E : Set Ω) (P : Set ℕ) (o : ℕ → ℕ → ℕ → Ω) : Prop :=
  ∀ u ∈ P, ∀ v ∈ P, ∀ w ∈ P, u < v → v < w → (o u v w ∈ E ↔ Ev3 p o E)

lemma homog13 (E : Set Ω) : ∃ P : Set ℕ, P.Infinite ∧
    HomogAt (p := p) E P o012 ∧ HomogAt (p := p) E P o120 ∧ HomogAt (p := p) E P o201 ∧
    HomogAt (p := p) E P o021 ∧ HomogAt (p := p) E P o210 ∧ HomogAt (p := p) E P o102 ∧
    HomogAt (p := p) E P t01_2 ∧ HomogAt (p := p) E P t2_01 ∧ HomogAt (p := p) E P t0_12 ∧
    HomogAt (p := p) E P t12_0 ∧ HomogAt (p := p) E P t02_1 ∧ HomogAt (p := p) E P t1_02 ∧
    HomogAt (p := p) E P t012 := by
  obtain ⟨P, hP, hT⟩ := ramsey3 hp (e3_and (e3_iff o012 E) (e3_and (e3_iff o120 E)
    (e3_and (e3_iff o201 E) (e3_and (e3_iff o021 E) (e3_and (e3_iff o210 E)
    (e3_and (e3_iff o102 E) (e3_and (e3_iff t01_2 E) (e3_and (e3_iff t2_01 E)
    (e3_and (e3_iff t0_12 E) (e3_and (e3_iff t12_0 E) (e3_and (e3_iff t02_1 E)
    (e3_and (e3_iff t1_02 E) (e3_iff t012 E)))))))))))))
  exact ⟨P, hP,
    fun u hu v hv w hw a b => (hT u hu v hv w hw a b).1,
    fun u hu v hv w hw a b => (hT u hu v hv w hw a b).2.1,
    fun u hu v hv w hw a b => (hT u hu v hv w hw a b).2.2.1,
    fun u hu v hv w hw a b => (hT u hu v hv w hw a b).2.2.2.1,
    fun u hu v hv w hw a b => (hT u hu v hv w hw a b).2.2.2.2.1,
    fun u hu v hv w hw a b => (hT u hu v hv w hw a b).2.2.2.2.2.1,
    fun u hu v hv w hw a b => (hT u hu v hv w hw a b).2.2.2.2.2.2.1,
    fun u hu v hv w hw a b => (hT u hu v hv w hw a b).2.2.2.2.2.2.2.1,
    fun u hu v hv w hw a b => (hT u hu v hv w hw a b).2.2.2.2.2.2.2.2.1,
    fun u hu v hv w hw a b => (hT u hu v hv w hw a b).2.2.2.2.2.2.2.2.2.1,
    fun u hu v hv w hw a b => (hT u hu v hv w hw a b).2.2.2.2.2.2.2.2.2.2.1,
    fun u hu v hv w hw a b => (hT u hu v hv w hw a b).2.2.2.2.2.2.2.2.2.2.2.1,
    fun u hu v hv w hw a b => (hT u hu v hv w hw a b).2.2.2.2.2.2.2.2.2.2.2.2⟩

omit hp in
lemma eight (P : Set ℕ) (hP : P.Infinite) : ∃ e₀ e₁ e₂ e₃ e₄ e₅ e₆ e₇, e₀ ∈ P ∧ e₁ ∈ P ∧
    e₂ ∈ P ∧ e₃ ∈ P ∧ e₄ ∈ P ∧ e₅ ∈ P ∧ e₆ ∈ P ∧ e₇ ∈ P ∧ e₀ < e₁ ∧ e₁ < e₂ ∧ e₂ < e₃ ∧
    e₃ < e₄ ∧ e₄ < e₅ ∧ e₅ < e₆ ∧ e₆ < e₇ := by
  have hf : (setOf (· ∈ P)).Infinite := hP
  have hmono := Nat.nth_strictMono hf
  exact ⟨_, _, _, _, _, _, _, _, Nat.nth_mem_of_infinite hf 0, Nat.nth_mem_of_infinite hf 1,
    Nat.nth_mem_of_infinite hf 2, Nat.nth_mem_of_infinite hf 3, Nat.nth_mem_of_infinite hf 4,
    Nat.nth_mem_of_infinite hf 5, Nat.nth_mem_of_infinite hf 6, Nat.nth_mem_of_infinite hf 7,
    hmono (by norm_num), hmono (by norm_num), hmono (by norm_num), hmono (by norm_num),
    hmono (by norm_num), hmono (by norm_num), hmono (by norm_num)⟩

omit hp in
/-- A cyclic or anticyclic strict profile on a homogeneous infinite set puts `E` in the
homogeneous-set family. -/
lemma inP_of_strict {E : Set Ω} {P : Set ℕ} (hP : P.Infinite)
    (H1 : HomogAt (p := p) E P o012) (H2 : HomogAt (p := p) E P o120)
    (H3 : HomogAt (p := p) E P o201) (H4 : HomogAt (p := p) E P o021)
    (H5 : HomogAt (p := p) E P o210) (H6 : HomogAt (p := p) E P o102)
    (hpat : (Wv p o012 E = 1 ∧ Wv p o120 E = 1 ∧ Wv p o201 E = 1 ∧ Wv p o021 E = 0 ∧
      Wv p o210 E = 0 ∧ Wv p o102 E = 0) ∨ (Wv p o012 E = 0 ∧ Wv p o120 E = 0 ∧
      Wv p o201 E = 0 ∧ Wv p o021 E = 1 ∧ Wv p o210 E = 1 ∧ Wv p o102 E = 1)) : InP E := by
  have z : ∀ {o : ℕ → ℕ → ℕ → Ω}, Wv p o E = 0 → ¬ Ev3 p o E := fun h h' => by
    rw [(wv_one p).mpr h'] at h; exact one_ne_zero h
  refine ⟨P, hP, ?_⟩
  rcases hpat with ⟨q1, q2, q3, q4, q5, q6⟩ | ⟨q1, q2, q3, q4, q5, q6⟩
  · refine Or.inl fun x hx hd => ?_
    obtain ⟨a, b, c, rfl⟩ : ∃ a b c, x = ![a, b, c] := ⟨_, _, _, eta x⟩
    obtain ⟨ha, hb, hc⟩ := hx
    simp only [Dist, v0, v1, v2] at hd ha hb hc
    simp only [Cyc, v0, v1, v2]
    rcases (show (a < b ∧ b < c) ∨ (b < c ∧ c < a) ∨ (c < a ∧ a < b) ∨ (a < c ∧ c < b) ∨
        (c < b ∧ b < a) ∨ (b < a ∧ a < c) by omega) with h | h | h | h | h | h
    · exact (H1 a ha b hb c hc h.1 h.2).trans ⟨fun _ => Or.inl h, fun _ => (wv_one p).mp q1⟩
    · exact (H2 b hb c hc a ha h.1 h.2).trans
        ⟨fun _ => Or.inr (Or.inl h), fun _ => (wv_one p).mp q2⟩
    · exact (H3 c hc a ha b hb h.1 h.2).trans
        ⟨fun _ => Or.inr (Or.inr h), fun _ => (wv_one p).mp q3⟩
    · exact (H4 a ha c hc b hb h.1 h.2).trans ⟨fun h' => absurd h' (z q4), fun h' => by omega⟩
    · exact (H5 c hc b hb a ha h.1 h.2).trans ⟨fun h' => absurd h' (z q5), fun h' => by omega⟩
    · exact (H6 b hb a ha c hc h.1 h.2).trans ⟨fun h' => absurd h' (z q6), fun h' => by omega⟩
  · refine Or.inr fun x hx hd => ?_
    obtain ⟨a, b, c, rfl⟩ : ∃ a b c, x = ![a, b, c] := ⟨_, _, _, eta x⟩
    obtain ⟨ha, hb, hc⟩ := hx
    simp only [Dist, v0, v1, v2] at hd ha hb hc
    simp only [Acy, v0, v1, v2]
    rcases (show (a < b ∧ b < c) ∨ (b < c ∧ c < a) ∨ (c < a ∧ a < b) ∨ (a < c ∧ c < b) ∨
        (c < b ∧ b < a) ∨ (b < a ∧ a < c) by omega) with h | h | h | h | h | h
    · exact (H1 a ha b hb c hc h.1 h.2).trans ⟨fun h' => absurd h' (z q1), fun h' => by omega⟩
    · exact (H2 b hb c hc a ha h.1 h.2).trans ⟨fun h' => absurd h' (z q2), fun h' => by omega⟩
    · exact (H3 c hc a ha b hb h.1 h.2).trans ⟨fun h' => absurd h' (z q3), fun h' => by omega⟩
    · exact (H4 a ha c hc b hb h.1 h.2).trans ⟨fun _ => Or.inl h, fun _ => (wv_one p).mp q4⟩
    · exact (H5 c hc b hb a ha h.1 h.2).trans
        ⟨fun _ => Or.inr (Or.inl h), fun _ => (wv_one p).mp q5⟩
    · exact (H6 b hb a ha c hc h.1 h.2).trans
        ⟨fun _ => Or.inr (Or.inr h), fun _ => (wv_one p).mp q6⟩

/-! ### Family `ddp`: windows x₀ = x₁, x₁ = x₂, and p ⊗ p on (x₀, x₂) with x₀ first. -/

/-- Functional of the family `ddp`. -/
noncomputable def s_ddp (p : Ultrafilter ℕ) (E : Set Ω) : ℤ := Wv p t01_2 E + Wv p t0_12 E - Wv p o012 E

set_option maxHeartbeats 1000000 in
theorem s_ddp_mem {E : Set Ω} (hE : D₃.Has E) : s_ddp p E = 0 ∨ s_ddp p E = 1 := by
  by_contra hne
  obtain ⟨P, hP, Ho012, Ho120, Ho201, Ho021, Ho210, Ho102, Ht01_2, Ht2_01, Ht0_12, Ht12_0, Ht02_1, Ht1_02, Ht012⟩ := homog13 hp E
  obtain ⟨e₀, e₁, e₂, e₃, e₄, e₅, e₆, e₇, m₀, m₁, m₂, m₃, m₄, m₅, m₆, m₇, l₀, l₁, l₂, l₃, l₄, l₅, l₆⟩ := eight P hP
  have hB := box_of_mem hE
  have k0 := cnt_wv (x := ![e₀, e₀, e₀]) (Ht012 e₀ m₀ e₆ m₆ e₇ m₇ (by omega) (by omega))
  have k1 := cnt_wv (x := ![e₁, e₁, e₀]) (Ht2_01 e₀ m₀ e₁ m₁ e₆ m₆ (by omega) (by omega))
  have k2 := cnt_wv (x := ![e₁, e₀, e₂]) (Ho102 e₀ m₀ e₁ m₁ e₂ m₂ (by omega) (by omega))
  have k3 := cnt_wv (x := ![e₀, e₁, e₂]) (Ho012 e₀ m₀ e₁ m₁ e₂ m₂ (by omega) (by omega))
  have k4 := cnt_wv (x := ![e₁, e₀, e₀]) (Ht12_0 e₀ m₀ e₁ m₁ e₆ m₆ (by omega) (by omega))
  have k5 := cnt_wv (x := ![e₀, e₁, e₀]) (Ht02_1 e₀ m₀ e₁ m₁ e₆ m₆ (by omega) (by omega))
  have k6 := cnt_wv (x := ![e₀, e₀, e₂]) (Ht01_2 e₀ m₀ e₂ m₂ e₆ m₆ (by omega) (by omega))
  have k7 := cnt_wv (x := ![e₁, e₁, e₂]) (Ht01_2 e₁ m₁ e₂ m₂ e₆ m₆ (by omega) (by omega))
  have b0 := hB e₀ e₁ e₀ e₁ e₀ e₂
  have b0' : (cnt E ![e₀, e₀, e₀] : ℤ) + (cnt E ![e₁, e₁, e₀] : ℤ) + (cnt E ![e₁, e₀, e₂] : ℤ) + (cnt E ![e₀, e₁, e₂] : ℤ) = (cnt E ![e₁, e₀, e₀] : ℤ) + (cnt E ![e₀, e₁, e₀] : ℤ) + (cnt E ![e₀, e₀, e₂] : ℤ) + (cnt E ![e₁, e₁, e₂] : ℤ) := by exact_mod_cast b0
  have k8 := cnt_wv (x := ![e₂, e₃, e₀]) (Ho201 e₀ m₀ e₂ m₂ e₃ m₃ (by omega) (by omega))
  have k9 := cnt_wv (x := ![e₂, e₁, e₃]) (Ho102 e₁ m₁ e₂ m₂ e₃ m₃ (by omega) (by omega))
  have k10 := cnt_wv (x := ![e₀, e₃, e₃]) (Ht0_12 e₀ m₀ e₃ m₃ e₆ m₆ (by omega) (by omega))
  have k11 := cnt_wv (x := ![e₂, e₁, e₀]) (Ho210 e₀ m₀ e₁ m₁ e₂ m₂ (by omega) (by omega))
  have k12 := cnt_wv (x := ![e₀, e₃, e₀]) (Ht02_1 e₀ m₀ e₃ m₃ e₆ m₆ (by omega) (by omega))
  have k13 := cnt_wv (x := ![e₀, e₁, e₃]) (Ho012 e₀ m₀ e₁ m₁ e₃ m₃ (by omega) (by omega))
  have k14 := cnt_wv (x := ![e₂, e₃, e₃]) (Ht0_12 e₂ m₂ e₃ m₃ e₆ m₆ (by omega) (by omega))
  have b1 := hB e₀ e₂ e₁ e₃ e₀ e₃
  have b1' : (cnt E ![e₀, e₁, e₀] : ℤ) + (cnt E ![e₂, e₃, e₀] : ℤ) + (cnt E ![e₂, e₁, e₃] : ℤ) + (cnt E ![e₀, e₃, e₃] : ℤ) = (cnt E ![e₂, e₁, e₀] : ℤ) + (cnt E ![e₀, e₃, e₀] : ℤ) + (cnt E ![e₀, e₁, e₃] : ℤ) + (cnt E ![e₂, e₃, e₃] : ℤ) := by exact_mod_cast b1
  have k15 := cnt_wv (x := ![e₀, e₁, e₁]) (Ht0_12 e₀ m₀ e₁ m₁ e₆ m₆ (by omega) (by omega))
  have k16 := cnt_wv (x := ![e₃, e₂, e₁]) (Ho210 e₁ m₁ e₂ m₂ e₃ m₃ (by omega) (by omega))
  have k17 := cnt_wv (x := ![e₃, e₁, e₂]) (Ho120 e₁ m₁ e₂ m₂ e₃ m₃ (by omega) (by omega))
  have k18 := cnt_wv (x := ![e₀, e₂, e₂]) (Ht0_12 e₀ m₀ e₂ m₂ e₆ m₆ (by omega) (by omega))
  have k19 := cnt_wv (x := ![e₃, e₁, e₁]) (Ht12_0 e₁ m₁ e₃ m₃ e₆ m₆ (by omega) (by omega))
  have k20 := cnt_wv (x := ![e₀, e₂, e₁]) (Ho021 e₀ m₀ e₁ m₁ e₂ m₂ (by omega) (by omega))
  have k21 := cnt_wv (x := ![e₃, e₂, e₂]) (Ht12_0 e₂ m₂ e₃ m₃ e₆ m₆ (by omega) (by omega))
  have b2 := hB e₀ e₃ e₁ e₂ e₁ e₂
  have b2' : (cnt E ![e₀, e₁, e₁] : ℤ) + (cnt E ![e₃, e₂, e₁] : ℤ) + (cnt E ![e₃, e₁, e₂] : ℤ) + (cnt E ![e₀, e₂, e₂] : ℤ) = (cnt E ![e₃, e₁, e₁] : ℤ) + (cnt E ![e₀, e₂, e₁] : ℤ) + (cnt E ![e₀, e₁, e₂] : ℤ) + (cnt E ![e₃, e₂, e₂] : ℤ) := by exact_mod_cast b2
  simp only [k0, k1, k2, k3, k4, k5, k6, k7, k8, k9, k10, k11, k12, k13, k14, k15, k16, k17, k18, k19, k20, k21] at b0' b1' b2'
  have w_o012 : 0 ≤ Wv p o012 E ∧ Wv p o012 E ≤ 1 := by
    rcases wv_cases p o012 E with h | h <;> rw [h] <;> norm_num
  have w_o120 : 0 ≤ Wv p o120 E ∧ Wv p o120 E ≤ 1 := by

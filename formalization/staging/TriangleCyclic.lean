  obtain ⟨g, hl⟩ : ∃ g : ℕ → ℕ → Prop, ∀ a b c : ℕ, (![b, c, a] ∈ E ↔ g a b) :=
    ⟨fun a b => ![b, 0, a] ∈ E, fun a b c => loc_of hE (by

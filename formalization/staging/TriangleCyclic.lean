/-! ## The triangle carries a pointless state -/

lemma window_mem {w : Set (Fin 3)} (hw : w ∈ W₃) (S : Set (w → ℕ)) :
    D₃.Has ((fun x (k : w) => x k) ⁻¹' S) :=
  DynkinSystem.GenerateHas.basic _ ⟨w, hw, ⟨S, (Set.to_countable S).measurableSet, rfl⟩⟩

lemma C₀_mem : D₃.Has C₀ :=
  window_mem (w := {0, 1}) (by simp [W₃]) {y | y ⟨0, by simp⟩ < y ⟨1, by simp⟩}
lemma C₁_mem : D₃.Has C₁ :=
  window_mem (w := {1, 2}) (by simp [W₃]) {y | y ⟨1, by simp⟩ < y ⟨2, by simp⟩}
lemma C₂_mem : D₃.Has C₂ :=
  window_mem (w := {2, 0}) (by simp [W₃]) {y | y ⟨2, by simp⟩ < y ⟨0, by simp⟩}

lemma C_inter : C₀ ∩ C₁ ∩ C₂ = ∅ := by
  ext x; simp only [C₀, C₁, C₂, mem_inter_iff, mem_setOf_eq, mem_empty_iff_false, iff_false]
  omega

/-- **The triangle carries a pointless finitely additive two-valued state** (for every
non-principal ultrafilter `p` on ℕ): `sstar p` is additive, normalised, {0,1}-valued on `D₃`, and
equals 1 on the three staircase steps, whose intersection is empty. -/
theorem triangle_pointless_state (p : Ultrafilter ℕ) (hp : ∀ m, ∀ᶠ n in (p : Filter ℕ), m < n) :
    (∀ E, D₃.Has E → sstar p E = 0 ∨ sstar p E = 1) ∧
    (∀ A B : Set Ω, Disjoint A B → sstar p (A ∪ B) = sstar p A + sstar p B) ∧
    sstar p univ = 1 ∧
    D₃.Has C₀ ∧ D₃.Has C₁ ∧ D₃.Has C₂ ∧
    sstar p C₀ = 1 ∧ sstar p C₁ = 1 ∧ sstar p C₂ = 1 ∧ C₀ ∩ C₁ ∩ C₂ = ∅ :=
  ⟨fun _ hE => sstar_mem hp hE, fun _ _ hd => sstar_union p hd, sstar_univ p,
    C₀_mem, C₁_mem, C₂_mem, sstar_C₀ hp, sstar_C₁ hp, sstar_C₂ hp, C_inter⟩

/-- Pointless: no ultrafilter on Ω (in particular no point) reproduces the state on `D₃`. -/
theorem triangle_state_no_ultrafilter (p : Ultrafilter ℕ) (hp : ∀ m, ∀ᶠ n in (p : Filter ℕ), m < n) :
    ¬ ∃ U : Ultrafilter Ω, ∀ E, D₃.Has E → (sstar p E = 1 ↔ E ∈ U) := by
  rintro ⟨U, hU⟩
  have h0 := (hU _ C₀_mem).mp (sstar_C₀ hp)
  have h1 := (hU _ C₁_mem).mp (sstar_C₁ hp)
  have h2 := (hU _ C₂_mem).mp (sstar_C₂ hp)
  have := U.inter_mem (U.inter_mem h0 h1) h2
  rw [C_inter] at this
  exact U.empty_notMem this

theorem triangle_state_no_point (p : Ultrafilter ℕ) (hp : ∀ m, ∀ᶠ n in (p : Filter ℕ), m < n) :
    ¬ ∃ ω : Ω, ∀ E, D₃.Has E → (sstar p E = 1 ↔ ω ∈ E) := by
  rintro ⟨ω, hω⟩
  have h0 := (hω _ C₀_mem).mp (sstar_C₀ hp)
  have h1 := (hω _ C₁_mem).mp (sstar_C₁ hp)
  have h2 := (hω _ C₂_mem).mp (sstar_C₂ hp)
  have : ω ∈ C₀ ∩ C₁ ∩ C₂ := ⟨⟨h0, h1⟩, h2⟩
  rw [C_inter] at this; exact this

/-- A non-principal ultrafilter exists (ZFC), so the triangle carries a pointless state. -/
theorem hyperfilter_gt (m : ℕ) : ∀ᶠ n in ((Filter.hyperfilter ℕ : Ultrafilter ℕ) : Filter ℕ), m < n :=
  Filter.hyperfilter_le_cofinite (Filter.eventually_cofinite.2 ((Set.finite_le_nat m).subset
    fun n hn => by simpa using hn))

lemma eq01_mem : D₃.Has {x : Ω | x 0 = x 1} :=
  window_mem (w := {0, 1}) (by simp [W₃]) {y | y ⟨0, by simp⟩ = y ⟨1, by simp⟩}
lemma eq12_mem : D₃.Has {x : Ω | x 1 = x 2} :=
  window_mem (w := {1, 2}) (by simp [W₃]) {y | y ⟨1, by simp⟩ = y ⟨2, by simp⟩}
lemma lt02_mem : D₃.Has {x : Ω | x 0 < x 2} :=
  window_mem (w := {2, 0}) (by simp [W₃]) {y | y ⟨0, by simp⟩ < y ⟨2, by simp⟩}

/-- **A graph-type twist on the triangle extends to a pointless state** (family `ddp`: windows
x₀ = x₁ and x₁ = x₂ diagonal, (x₀, x₂) the product with x₀ first). -/
theorem triangle_ddp_pointless (p : Ultrafilter ℕ) (hp : ∀ m, ∀ᶠ n in (p : Filter ℕ), m < n) :
    (∀ E, D₃.Has E → s_ddp p E = 0 ∨ s_ddp p E = 1) ∧
    (∀ A B : Set Ω, Disjoint A B → s_ddp p (A ∪ B) = s_ddp p A + s_ddp p B) ∧
    s_ddp p univ = 1 ∧
    (∀ E, @MeasurableSet _ (windowSigma {0, 1}) E → s_ddp p E = diag01 p E) ∧
    (∀ E, @MeasurableSet _ (windowSigma {1, 2}) E → s_ddp p E = diag12 p E) ∧
    (∀ E, @MeasurableSet _ (windowSigma {2, 0}) E → s_ddp p E = prod02 p E) ∧
    ¬ ∃ U : Ultrafilter Ω, ∀ E, D₃.Has E → (s_ddp p E = 1 ↔ E ∈ U) := by
  refine ⟨fun _ hE => s_ddp_mem hp hE, fun _ _ hd => s_ddp_union hd, s_ddp_univ,
    fun _ hE => s_ddp_window01 hE, fun _ hE => s_ddp_window12 hE, fun _ hE => s_ddp_window20 hE, ?_⟩
  rintro ⟨U, hU⟩
  obtain ⟨h0, h1, h2⟩ := ddp_steps hp
  have := U.inter_mem (U.inter_mem ((hU _ eq01_mem).mp h0) ((hU _ eq12_mem).mp h1))
    ((hU _ lt02_mem).mp h2)
  have he : {x : Ω | x 0 = x 1} ∩ {x | x 1 = x 2} ∩ {x | x 0 < x 2} = ∅ := by
    ext x; simp only [mem_inter_iff, mem_setOf_eq, mem_empty_iff_false, iff_false]; omega
  rw [he] at this; exact U.empty_notMem this

/-- **A mixed twist on the triangle extends to a pointless state** (family `dpp`: x₀ = x₁
diagonal, (x₁, x₂) with x₁ first, (x₂, x₀) with x₂ first). -/
theorem triangle_dpp_pointless (p : Ultrafilter ℕ) (hp : ∀ m, ∀ᶠ n in (p : Filter ℕ), m < n) :
    (∀ E, D₃.Has E → s_dpp p E = 0 ∨ s_dpp p E = 1) ∧
    (∀ A B : Set Ω, Disjoint A B → s_dpp p (A ∪ B) = s_dpp p A + s_dpp p B) ∧
    s_dpp p univ = 1 ∧
    (∀ E, @MeasurableSet _ (windowSigma {0, 1}) E → s_dpp p E = diag01 p E) ∧
    (∀ E, @MeasurableSet _ (windowSigma {1, 2}) E → s_dpp p E = stair12 p E) ∧
    (∀ E, @MeasurableSet _ (windowSigma {2, 0}) E → s_dpp p E = stair20 p E) ∧
    ¬ ∃ U : Ultrafilter Ω, ∀ E, D₃.Has E → (s_dpp p E = 1 ↔ E ∈ U) := by
  refine ⟨fun _ hE => s_dpp_mem hp hE, fun _ _ hd => s_dpp_union hd, s_dpp_univ,
    fun _ hE => s_dpp_window01 hE, fun _ hE => s_dpp_window12 hE, fun _ hE => s_dpp_window20 hE, ?_⟩
  rintro ⟨U, hU⟩
  obtain ⟨h0, h1, h2⟩ := dpp_steps hp
  have := U.inter_mem (U.inter_mem ((hU _ eq01_mem).mp h0) ((hU _ C₁_mem).mp h1))
    ((hU _ C₂_mem).mp h2)
  have he : {x : Ω | x 0 = x 1} ∩ C₁ ∩ C₂ = ∅ := by
    ext x; simp only [C₁, C₂, mem_inter_iff, mem_setOf_eq, mem_empty_iff_false, iff_false]; omega
  rw [he] at this; exact U.empty_notMem this

/-- **Unconditional form.** The triangle carrier over ℕ carries a finitely additive two-valued
state that no ultrafilter on Ω (in particular no point) reproduces. -/
theorem triangle_has_pointless_state :
    ∃ s : Set Ω → ℤ, (∀ E, D₃.Has E → s E = 0 ∨ s E = 1) ∧
      (∀ A B : Set Ω, Disjoint A B → s (A ∪ B) = s A + s B) ∧ s univ = 1 ∧
      ¬ ∃ U : Ultrafilter Ω, ∀ E, D₃.Has E → (s E = 1 ↔ E ∈ U) :=
  ⟨sstar (Filter.hyperfilter ℕ), (triangle_pointless_state _ hyperfilter_gt).1,
    (triangle_pointless_state _ hyperfilter_gt).2.1, (triangle_pointless_state _ hyperfilter_gt).2.2.1,
    triangle_state_no_ultrafilter _ hyperfilter_gt⟩

/-! ## Over ℤ: restriction to ℕ³ (transport lemma)

The triangle carrier over ℤ pulls back into the triangle carrier over ℕ along the coordinatewise
inclusion `ι`. So no set over ℤ whose restriction to ℕ³ lies in the family `InF` is buildable over
ℤ. In particular Navara's set K(0,0) = {[x₁<x₀] + [x₂<x₁] − [x₂<x₀] = 1}, the anticyclic set off
ties, is not in the carrier over ℤ (`navaraK_not_mem`). -/

section OverZ

abbrev ΩZ := Fin 3 → ℤ

abbrev windowSigmaZ (w : Set (Fin 3)) : MeasurableSpace ΩZ :=
  MeasurableSpace.comap (fun x (k : w) => x k) MeasurableSpace.pi

def gensZ : Set (Set ΩZ) := {E | ∃ w ∈ W₃, @MeasurableSet _ (windowSigmaZ w) E}

/-- The triangle carrier over ℤ. -/
def D₃Z : DynkinSystem ΩZ := DynkinSystem.generate gensZ

/-- Coordinatewise inclusion ℕ³ → ℤ³. -/
def ι (x : Ω) : ΩZ := fun i => (x i : ℤ)

lemma gens_pre {E : Set ΩZ} (hE : E ∈ gensZ) : ι ⁻¹' E ∈ gens := by
  obtain ⟨w, hw, s, hs, rfl⟩ := hE
  refine ⟨w, hw, (fun (y : w → ℕ) (k : w) => (y k : ℤ)) ⁻¹' s, ?_, rfl⟩
  exact measurable_pi_lambda _ (fun k => measurable_from_nat.comp (measurable_pi_apply k)) hs

/-- **Transport.** Preimages of carrier sets over ℤ are carrier sets over ℕ. -/
theorem mem_pre {E : Set ΩZ} (hE : D₃Z.Has E) : D₃.Has (ι ⁻¹' E) := by
  induction hE with
  | basic t ht => exact DynkinSystem.GenerateHas.basic _ (gens_pre ht)
  | empty => exact D₃.has_empty
  | @compl s _ ih => rw [preimage_compl]; exact D₃.has_compl ih
  | @iUnion f hd _ ih =>
    rw [preimage_iUnion]
    exact D₃.has_iUnion (fun i j hij => (hd hij).preimage ι) ih

theorem not_mem_of_restrict_inF {E : Set ΩZ} (h : InF (ι ⁻¹' E)) : ¬ D₃Z.Has E :=
  fun hE => not_inF_of_mem (mem_pre hE) h

/-- Navara's K(0,0) over ℤ, written without subtraction. -/
def navaraK : Set ΩZ :=
  {x | (if x 1 < x 0 then (1 : ℤ) else 0) + (if x 2 < x 1 then 1 else 0) =
        1 + (if x 2 < x 0 then 1 else 0)}

lemma navaraK_restrict_inF : InF (ι ⁻¹' navaraK) := by
  refine ⟨0, Or.inr fun x hx => ?_⟩
  unfold Far at hx
  simp only [mem_preimage, navaraK, mem_setOf_eq, ι, Nat.cast_lt, Acy]
  split_ifs <;> omega

/-- **Navara's witness is not buildable over ℤ.** -/
theorem navaraK_not_mem : ¬ D₃Z.Has navaraK := not_mem_of_restrict_inF navaraK_restrict_inF

end OverZ

